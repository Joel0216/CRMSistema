@model CRMSistema.Models.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Panel de Control";
}

<div class="page-header">
    <div>
        <h2 class="section-title">Panel de control</h2>
        <p class="section-sub">Resumen en tiempo real del sistema comercial</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

<!-- KPI GRID -->
<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-top">
            <div>
                <div class="metric-label">Ingresos del mes</div>
                <h3 class="metric-value">@Model.Kpis.ingresosMes.valor.ToString("C0", new System.Globalization.CultureInfo("es-MX"))</h3>
            </div>
            <div class="metric-icon" style="background:#ecfdf5;color:#059669;">
                <i class="fas fa-dollar-sign"></i>
            </div>
        </div>
        <div class="metric-trend @(Model.Kpis.ingresosMes.cambio >= 0 ? "up" : "down")">
            <i class="fas @(Model.Kpis.ingresosMes.cambio >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
            <span>@(Model.Kpis.ingresosMes.cambio >= 0 ? "+" : "")@Model.Kpis.ingresosMes.cambio%</span>
            <span style="color:#94a3b8;font-weight:400;">vs mes anterior</span>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-top">
            <div>
                <div class="metric-label">Nuevos prospectos</div>
                <h3 class="metric-value">@Model.Kpis.prospectosMes.valor</h3>
            </div>
            <div class="metric-icon" style="background:#eef2ff;color:#4f46e5;">
                <i class="fas fa-users"></i>
            </div>
        </div>
        <div class="metric-trend @(Model.Kpis.prospectosMes.cambio >= 0 ? "up" : "down")">
            <i class="fas @(Model.Kpis.prospectosMes.cambio >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
            <span>@(Model.Kpis.prospectosMes.cambio >= 0 ? "+" : "")@Model.Kpis.prospectosMes.cambio%</span>
            <span style="color:#94a3b8;font-weight:400;">vs mes anterior</span>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-top">
            <div>
                <div class="metric-label">Cotizaciones activas</div>
                <h3 class="metric-value">@(Model.Kpis.cotizaciones?.total ?? 0)</h3>
            </div>
            <div class="metric-icon" style="background:#fffbeb;color:#d97706;">
                <i class="fas fa-file-invoice"></i>
            </div>
        </div>
        <div class="metric-trend neutral">
            <span>@(Model.Kpis.cotizaciones?.servicios ?? 0) servicios &middot; @(Model.Kpis.cotizaciones?.borradores ?? 0) borradores</span>
        </div>
    </div>
</div>

<!-- KPI EXTRA -->
<div class="metric-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="metric-card" style="border-left-color:#dc2626;">
        <div class="metric-top">
            <div>
                <div class="metric-label">Deudores</div>
                <h3 class="metric-value">@Model.Kpis.deudores</h3>
            </div>
            <div class="metric-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-exclamation-triangle"></i></div>
        </div>
    </div>

    <div class="metric-card" style="border-left-color:#059669;">
        <div class="metric-top"> 
            <div>
                <div class="metric-label">Al corriente</div>
                <h3 class="metric-value">@Model.Kpis.alCorriente</h3>
            </div>
            <div class="metric-icon" style="background:#d1fae5;color:#059669;"><i class="fas fa-check-circle"></i></div>
        </div>
    </div>

    <div class="metric-card" style="border-left-color:#4f46e5;">
        <div class="metric-top">
            <div>
                <div class="metric-label">Prospectos con sucursales</div>
                <h3 class="metric-value">@(Model.Kpis.sucursales?.prospectosConSuc ?? 0)</h3>
            </div>
            <div class="metric-icon" style="background:#eef2ff;color:#4f46e5;"><i class="fas fa-building"></i></div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><i class="fas fa-chart-line me-2"></i>Evoluci&oacute;n comercial</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="tendenciaChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="fas fa-chart-pie me-2"></i>Crecimiento comercial</span>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2" style="font-size:12px;">
                    <div class="d-flex align-items-center gap-1">
                        <select id="mesInicio" class="form-select form-select-sm" style="width:auto; min-width:110px; font-size:12px;">
                            @{
                                var hoy = DateTime.Now;
                                for (int i = 0; i < 12; i++)
                                {
                                    var d = hoy.AddMonths(-i);
                                    var val = d.ToString("yyyy-MM");
                                    var txt = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(d.Month).Substring(0, 3) + " " + d.Year;
                                    var sel = i == 0 ? "selected" : "";
                                    <option value="@val" @sel>@txt</option>
                                }
                            }
                        </select>
                        <span style="color:var(--text3);">-</span>
                        <select id="mesFin" class="form-select form-select-sm" style="width:auto; min-width:110px; font-size:12px;">
                            @{
                                for (int i = 0; i < 12; i++)
                                {
                                    var d = hoy.AddMonths(-i);
                                    var val = d.ToString("yyyy-MM");
                                    var txt = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(d.Month).Substring(0, 3) + " " + d.Year;
                                    var sel = i == 1 ? "selected" : "";
                                    <option value="@val" @sel>@txt</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-check d-flex align-items-center gap-1 mb-0" style="font-size:12px;">
                        <input class="form-check-input" type="checkbox" id="chkComparar" style="cursor:pointer; margin-top:0;">
                        <label class="form-check-label" for="chkComparar" style="cursor:pointer; color:var(--text2); white-space:nowrap;">Comparar</label>
                    </div>
                </div>
                <div id="tituloCrecimiento" style="font-size:11px; font-weight:700; color:var(--text2); margin-bottom:8px; text-align:center;"></div>
                <div class="row g-2">
                    <div class="col-6 text-center">
                        <div id="tituloMesA" style="font-size:11px; font-weight:600; color:var(--text2); margin-bottom:4px;"></div>
                        <div class="chart-container" style="height:160px;">
                            <canvas id="pastelA"></canvas>
                        </div>
                    </div>
                    <div class="col-6 text-center">
                        <div id="tituloMesB" style="font-size:11px; font-weight:600; color:var(--text2); margin-bottom:4px;"></div>
                        <div class="chart-container" style="height:160px;">
                            <canvas id="pastelB"></canvas>
                        </div>
                    </div>
                </div>
                <div id="leyendaPastel" class="mt-2" style="font-size:11px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- PIPELINE TABLE -->
<div class="card">
    <div class="card-header"><i class="fas fa-table me-2"></i>Pipeline inmediato</div>
    <div class="card-body table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Empresa / Cliente</th>
                    <th>Contacto</th>
                    <th>Estatus</th>
                    <th>Sucursales</th>
                    <th style="text-align:right;">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pipeline)
                {
                    <tr>
                        <td style="font-weight:700;">@(p.empresa ?? "&mdash;")</td>
                        <td>@(p.contacto ?? "&mdash;")</td>
                        <td>@Html.Partial("~/Views/Prospectos/_BadgeEstatus.cshtml", p.estatus)</td>
                        <td style="text-align:center;">@(p.tieneSucursales ?? "No")</td>
                        <td style="text-align:right; font-weight:700;">@(p.monto > 0 ? p.monto.ToString("C0", new System.Globalization.CultureInfo("es-MX")) : "--")</td>
                    </tr>
                }
                @if (Model.Pipeline.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="text-align:center; color:var(--text3); padding:40px;">No hay prospectos registrados</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- COTIZACIONES RECIENTES -->
@if (Model.CotizacionesDetalle.Count > 0)
{
    <div class="card">
        <div class="card-header"><i class="fas fa-file-invoice-dollar me-2"></i>Cotizaciones recientes</div>
        <div class="card-body table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Tipo Residuo</th>
                        <th>Frecuencia</th>
                        <th>Periodicidad</th>
                        <th style="text-align:right;">Volumen</th>
                        <th style="text-align:right;">Precio Unit.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CotizacionesDetalle)
                    {
                        <tr>
                            <td style="font-weight:700;">@(c.empresa ?? "&mdash;")</td>
                            <td>@(c.tipo_residuo ?? "&mdash;")</td>
                            <td>@(c.frecuencia ?? "&mdash;")</td>
                            <td>@(c.periodicidad_pago ?? "&mdash;")</td>
                            <td style="text-align:right;">@(c.volumen_estimado > 0 ? c.volumen_estimado.ToString("N2") : "&mdash;")</td>
                            <td style="text-align:right; font-weight:700;">@(c.precio_unitario > 0 ? c.precio_unitario.ToString("C2", new System.Globalization.CultureInfo("es-MX")) : "&mdash;")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section scripts {
    <script>
        var tendenciaData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Tendencia));
        var estatusInicial = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EstatusDistribucion));
        var urlEstatusPorMes = '@Url.Action("GetEstatusDistribucionPorMes", "Dashboard")';
        var mesesNombres = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

        // Gráfica de línea
        var labels = tendenciaData.map(function(t) {
            var partes = t.mes.split('-');
            return mesesNombres[parseInt(partes[1], 10) - 1] + ' ' + partes[0];
        });

        var ctxLine = document.getElementById('tendenciaChart').getContext('2d');
        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Prospectos',
                        data: tendenciaData.map(function(t) { return t.prospectos; }),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,0.1)',
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Ingresos ($)',
                        data: tendenciaData.map(function(t) { return t.ingresos; }),
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99,102,241,0.1)',
                        fill: true,
                        tension: 0.4,
                        yAxisID: 'y2'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { beginAtZero: true, title: { display: true, text: 'Prospectos' } },
                    y2: { position: 'right', beginAtZero: true, title: { display: true, text: 'Ingresos ($)' }, grid: { drawOnChartArea: false } }
                }
            }
        });

        // Gráficas de pastel compactas — Crecimiento comercial
        var coloresPastel = ['#6366f1', '#f59e0b', '#10b981', '#ef4444', '#8b5cf6', '#14b8a6', '#94a3b8', '#f97316'];
        var chartA = null;
        var chartB = null;

        function etiquetaMesCorto(valorMes) {
            var p = valorMes.split('-');
            return mesesNombres[parseInt(p[1], 10) - 1] + ' ' + p[0];
        }

        function crearPastelCompacto(ctx, datos) {
            var labels = datos.map(function(x) { return x.estatus; });
            var valores = datos.map(function(x) { return x.cantidad; });
            var colores = datos.map(function(_, i) { return coloresPastel[i % coloresPastel.length]; });
            return new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: colores,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    var total = context.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                                    var pct = total > 0 ? Math.round((context.raw / total) * 100) : 0;
                                    return context.label + ': ' + context.raw + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }

        function cargarEstatusPorMes(mes) {
            return $.get(urlEstatusPorMes, { mes: mes })
                .then(function(data) {
                    return (data && data.success) ? (data.data || []) : [];
                })
                .fail(function() {
                    return [];
                });
        }

        function datosConFallback(datos, mes) {
            var mesActual = new Date().toISOString().slice(0, 7);
            if ((!datos || datos.length === 0) && estatusInicial && estatusInicial.length > 0 && mes === mesActual) {
                return estatusInicial;
            }
            return datos || [];
        }

        function renderLeyendaPastel(datosA, datosB) {
            var set = {};
            (datosA || []).forEach(function(x, i) { set[x.estatus] = coloresPastel[i % coloresPastel.length]; });
            (datosB || []).forEach(function(x, i) { if (!set[x.estatus]) set[x.estatus] = coloresPastel[i % coloresPastel.length]; });
            var html = '<div style="display:flex; flex-wrap:wrap; gap:6px; justify-content:center;">';
            Object.keys(set).sort().forEach(function(estatus) {
                html += '<span style="display:inline-flex; align-items:center; gap:3px;">' +
                        '<span style="width:8px; height:8px; border-radius:50%; background:' + set[estatus] + ';"></span>' +
                        '<span style="font-size:11px; color:var(--text2);">' + estatus + '</span></span>';
            });
            html += '</div>';
            document.getElementById('leyendaPastel').innerHTML = html;
        }

        function actualizarPastel(chart, ctx, datos) {
            if (chart) chart.destroy();
            return datos.length > 0 ? crearPastelCompacto(ctx, datos) : null;
        }

        function cargarCrecimiento() {
            var mesA = $('#mesInicio').val();
            var mesB = $('#mesFin').val();
            var comparar = $('#chkComparar').is(':checked');

            $('#tituloCrecimiento').text('Crecimiento comercial' + (comparar ? ' — comparativa' : ''));
            $('#tituloMesA').text(etiquetaMesCorto(mesA));

            $.when(cargarEstatusPorMes(mesA), comparar ? cargarEstatusPorMes(mesB) : $.Deferred().resolve([]))
                .done(function(datosA, datosB) {
                    datosA = datosConFallback(datosA, mesA);
                    datosB = comparar ? datosConFallback(datosB, mesB) : [];

                    chartA = actualizarPastel(chartA, document.getElementById('pastelA').getContext('2d'), datosA);

                    if (comparar) {
                        $('#tituloMesB').text(etiquetaMesCorto(mesB)).show();
                        document.getElementById('pastelB').parentElement.parentElement.style.display = 'block';
                        chartB = actualizarPastel(chartB, document.getElementById('pastelB').getContext('2d'), datosB);
                    } else {
                        $('#tituloMesB').text('').hide();
                        document.getElementById('pastelB').parentElement.parentElement.style.display = 'none';
                        if (chartB) { chartB.destroy(); chartB = null; }
                    }

                    renderLeyendaPastel(datosA, datosB);
                }).fail(function() {
                    if (chartA) chartA.destroy();
                    if (chartB) chartB.destroy();
                    document.getElementById('leyendaPastel').innerHTML = '';
                });
        }

        $(function() {
            cargarCrecimiento();
            $('#mesInicio, #mesFin, #chkComparar').on('change', cargarCrecimiento);
        });
    </script>
}
