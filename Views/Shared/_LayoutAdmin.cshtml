<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - CRM Sistema</title>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @Styles.Render("~/Content/css")
    @RenderSection("styles", required: false)
</head>
<body class="modal-open" style="overflow: auto;" autocomplete="off">
    <div class="layout">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div style="font-size: 20px; font-weight: bold; color: white; padding: 10px;">Ciclo Ambiental</div>
            </div>

@{
                var rol = Session["Rol"]?.ToString() ?? "";
                var permisosMenu = CRMSistema.Models.Permisos.PermisoService.ObtenerPermisosDesdeSesion();
                var nombreUsuarioRaw = Session["UsuarioNombre"]?.ToString() ?? User.Identity?.Name ?? "";
                var nombreUsuario = !string.IsNullOrWhiteSpace(nombreUsuarioRaw) ? nombreUsuarioRaw : "Usuario";
            }

            <nav class="sidebar-nav">
                @foreach (var menu in permisosMenu.Where(m => !string.Equals(m.Nombre, "INDICADORES", StringComparison.OrdinalIgnoreCase)))
                {
                    <div>
                        <div class="nav-section-title">@menu.Nombre</div>
                        @foreach (var sm in menu.SubMenus.Where(sm => !string.Equals(sm.Nombre, "Registrar usuario", StringComparison.OrdinalIgnoreCase)
                                                              && !string.Equals(sm.Nombre, "Reportes", StringComparison.OrdinalIgnoreCase)
                                                              && !string.Equals(sm.Nombre, "INDICADORES Reportes", StringComparison.OrdinalIgnoreCase)))
                        {
                            var activeClass = ViewBag.ActiveMenu != null && ViewBag.ActiveMenu.ToString().Equals(sm.Nombre.Replace(" ", ""), StringComparison.OrdinalIgnoreCase) ? "active" : "";
                            var iconHtml = !string.IsNullOrEmpty(sm.Icono) ? $"<i class='fas {sm.Icono} me-2'></i> " : "";
                            <a href="@Url.Action(sm.Accion, sm.Controlador)" class="nav-link @activeClass">
                                @Html.Raw(iconHtml)@sm.Nombre
                            </a>
                        }
                    </div>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="dropdown">
                    <button class="user-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background: transparent; border: none; width: 100%; text-align: left;">
                        <div class="avatar">
                            @(nombreUsuario.Substring(0, 1).ToUpper())
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div class="user-name" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @nombreUsuario
                            </div>
                            <div class="user-rol">@(rol != "" ? rol : "Usuario")</div>
                        </div>
                    </button>
                    <ul class="dropdown-menu" style="min-width: 220px;">
                        <li><a class="dropdown-item" href="#" id="btnCambiarMiPassword"><i class="fas fa-key me-2"></i> Cambiar contraseña</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Acceso")"><i class="fas fa-sign-out-alt me-2"></i> Cerrar sesi&oacute;n</a></li>
                    </ul>
                </div>
            </div>
        </aside>

        <main class="main-content">
            <div class="topbar">
                <div class="topbar-dot"></div>
                <span class="topbar-title">@ViewBag.Title</span>
            </div>
            <div class="content-body">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Modal cambiar contraseña -->
    <div class="modal fade" id="modalCambiarPassword" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-key me-2"></i>Cambiar mi contrase&ntilde;a</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formCambiarPassword">
                        <div class="mb-3">
                            <label class="form-label">Contrase&ntilde;a actual</label>
                            <input type="password" class="form-control" id="passwordActual" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nueva contrase&ntilde;a</label>
                            <input type="password" class="form-control" id="passwordNuevo" required minlength="6" />
                            <div class="form-text">M&iacute;nimo 6 caracteres.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirmar nueva contrase&ntilde;a</label>
                            <input type="password" class="form-control" id="passwordConfirmar" required minlength="6" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnGuardarPassword">Guardar cambios</button>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <!-- Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {
            var modal = new bootstrap.Modal(document.getElementById('modalCambiarPassword'));

            $('#btnCambiarMiPassword').on('click', function (e) {
                e.preventDefault();
                $('#formCambiarPassword')[0].reset();
                modal.show();
            });

            $('#btnGuardarPassword').on('click', function () {
                var actual = $('#passwordActual').val().trim();
                var nuevo = $('#passwordNuevo').val().trim();
                var confirmar = $('#passwordConfirmar').val().trim();

                if (!actual || !nuevo || !confirmar) {
                    Swal.fire('Campos incompletos', 'Completa todos los campos.', 'warning');
                    return;
                }
                if (nuevo !== confirmar) {
                    Swal.fire('No coinciden', 'La nueva contraseña y su confirmación no coinciden.', 'warning');
                    return;
                }
                if (nuevo.length < 6) {
                    Swal.fire('Demasiado corta', 'La nueva contraseña debe tener al menos 6 caracteres.', 'warning');
                    return;
                }

                $.post('@Url.Action("CambiarPassword", "MiCuenta")', {
                    passwordActual: actual,
                    passwordNuevo: nuevo,
                    passwordConfirmar: confirmar
                }).done(function (res) {
                    if (res.success) {
                        modal.hide();
                        Swal.fire('Listo', res.message, 'success');
                        $('#formCambiarPassword')[0].reset();
                    } else {
                        Swal.fire('Error', res.error || 'No se pudo actualizar.', 'error');
                    }
                }).fail(function () {
                    Swal.fire('Error', 'Ocurrió un error de comunicación.', 'error');
                });
            });
        });
    </script>

    @Scripts.Render("~/bundles/site")
    @RenderSection("scripts", required: false)
</body>
</html>
