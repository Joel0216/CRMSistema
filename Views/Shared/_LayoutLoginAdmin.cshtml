<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Acceso Administrador</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @RenderSection("styles", required: false)
</head>
<body class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img src="~/Content/Assets/logo_ecolsur.png" alt="Logo" onerror="this.style.display='none'" />
            <div class="login-title">Ciclo Ambiental</div>
            <div class="login-subtitle">Acceso Administradores</div>
        </div>

        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
