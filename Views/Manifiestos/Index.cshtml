@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Manifiestos";
    ViewBag.ActiveMenu = "Manifiestos";
}

@*
    VISTA DE MANIFIESTOS
    ====================
    Maqueta funcional del módulo "Manifiestos".

    UBICACIÓN DEL CONTROLADOR Y VISTA
    ---------------------------------
    - Controller : Controllers/Manifiestos/ManifiestosController.cs
    - Vista      : Views/Manifiestos/Index.cshtml
    - Layout     : Views/Shared/_LayoutAdmin.cshtml
    - Menú       : Models/Permisos/PermisoService.cs  ->  "OPERACIONES > Manifiestos"
    - Acceso     : Supervisor, Coordinador, Jefe y Superadmin

    ¿Qué captura esta vista?
    - Folio, Fecha, Generador, Transportista, Destino final, Volumen (ton) y Estatus.

    ¿Dónde se ponen las rutas / relación con Rutas Cotizadas?
    - Un manifiesto puede nacer de una cotización ya asignada (Rutas Cotizadas).
    - Cuando Operaciones tenga la tabla real, se puede agregar aquí un campo
      "Cotización / Ruta asignada" que jale los folios de crm_rutas_cotizadas.
    - El botón "Nuevo manifiesto" puede precargarse automáticamente desde la
      vista de Rutas Cotizadas con un enlace tipo:
        @Url.Action("Index", "Manifiestos", new { cotizacionId = id })
      y en Index leer ese parámetro para precargar generador/destino.

    ¿Cómo se pone en producción?
    1. Operaciones crea la tabla crm_manifiestos (ver comentarios en el controller).
    2. Se crean los stored procedures SP_Manifiestos_GetAll / _Insert / _Update.
    3. Se reemplaza GenerarDatosDemo() por llamadas al DAL.
    4. Se conectan los botones "Ver" y "PDF" a acciones del controller.
*@

<style>
    /* Modal de manifiesto al estilo prospecto/usuario */
    #modalManifiestoOverlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        background: rgba(63,40,26,0.50);
        backdrop-filter: blur(3px);
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
    }
    #modalManifiestoOverlay.show { display: flex; }
    .modal-manifiesto-box {
        background: white;
        border-radius: 14px;
        width: 720px;
        max-width: 95%;
        max-height: 95vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 32px rgba(63,40,26,0.15);
        overflow: hidden;
    }
    .modal-manifiesto-header {
        background: var(--brown-dark);
        color: white;
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }
    .modal-manifiesto-title { font-size: 16px; font-weight: 700; text-transform: uppercase; }
    .modal-manifiesto-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }
    .modal-manifiesto-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .modal-manifiesto-footer {
        padding: 16px 24px;
        border-top: 1px solid #EDE4D8;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-shrink: 0;
        background: #FAF6F1;
    }
    @@media (max-width: 767.98px) {
        #modalManifiestoOverlay { padding: 0; }
        .modal-manifiesto-box {
            width: 100%;
            max-width: 100%;
            height: 100vh;
            max-height: 100vh;
            border-radius: 0;
        }
        .modal-manifiesto-header { border-radius: 0; }
        .modal-manifiesto-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="section-title mb-0"><i class="fas fa-file-alt me-2"></i>Manifiestos</h2>
        <p class="section-sub mb-0" id="lblCount">Cargando...</p>
    </div>
    <button class="btn-custom btn-primary-custom" onclick="abrirModalManifiesto()">
        <i class="fas fa-plus me-2"></i>Nuevo manifiesto
    </button>
</div>

<div class="search-bar">
    <div class="search-wrap">
        <span class="search-icon">&#128269;</span>
        <input type="text" id="buscarManifiesto" class="form-input" placeholder="Buscar manifiesto...">
    </div>
    <select id="filtroEstatus" class="form-input" style="width: 200px;">
        <option value="">Todos los estatus</option>
        <option>Entregado</option>
        <option>En tránsito</option>
        <option>Cancelado</option>
    </select>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="table" id="tblManifiestos" style="min-width: 900px;">
            <thead>
                <tr>
                    <th>NÚMERO</th>
                    <th>FECHA</th>
                    <th>GENERADOR</th>
                    <th>TRANSPORTISTA</th>
                    <th>DESTINO FINAL</th>
                    <th style="text-align: center;">VOLUMEN (TON)</th>
                    <th style="text-align: center;">ESTATUS</th>
                    <th style="text-align: center;">ACCIONES</th>
                </tr>
            </thead>
            <tbody id="tbManifiestos">
                <tr><td colspan="8" class="text-center py-4">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nuevo Manifiesto -->
<div id="modalManifiestoOverlay" onclick="cerrarModalManifiesto(event)">
    <div class="modal-manifiesto-box" onclick="event.stopPropagation()">
        <div class="modal-manifiesto-header">
            <h5 class="modal-manifiesto-title">Nuevo Manifiesto</h5>
            <button type="button" onclick="cerrarModalManifiesto()" style="background:rgba(255,255,255,0.2); color:white; border:none; border-radius:6px; padding:4px 12px; font-weight:600;">Cerrar</button>
        </div>
        <div class="modal-manifiesto-body">
            <div class="modal-manifiesto-grid">
                <div class="form-group">
                    <label class="form-label">Folio *</label>
                    <input type="text" class="form-control form-control-sm" id="mFolio" placeholder="MAN-2026-000" />
                </div>
                <div class="form-group">
                    <label class="form-label">Fecha *</label>
                    <input type="date" class="form-control form-control-sm" id="mFecha" />
                </div>
                <div class="form-group">
                    <label class="form-label">Generador *</label>
                    <input type="text" class="form-control form-control-sm" id="mGenerador" placeholder="Empresa generadora" />
                </div>
                <div class="form-group">
                    <label class="form-label">Transportista *</label>
                    <input type="text" class="form-control form-control-sm" id="mTransportista" placeholder="Transportista" />
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="form-label">Destino final *</label>
                    <input type="text" class="form-control form-control-sm" id="mDestino" placeholder="Destino final" />
                </div>
                <div class="form-group">
                    <label class="form-label">Volumen (ton) *</label>
                    <input type="number" step="0.01" class="form-control form-control-sm" id="mVolumen" placeholder="0.00" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estatus *</label>
                    <select class="form-select form-select-sm" id="mEstatus">
                        <option value="">-- Seleccionar --</option>
                        <option value="Entregado">Entregado</option>
                        <option value="En tránsito">En tránsito</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-manifiesto-footer">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cerrarModalManifiesto()">Cancelar</button>
            <button type="button" class="btn btn-success btn-sm" onclick="guardarManifiesto()">Guardar manifiesto</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let manifiestos = [];

        $(document).ready(function () {
            cargarManifiestos();

            $('#buscarManifiesto').on('keyup', function () {
                const valor = $(this).val().toLowerCase();
                $('#tblManifiestos tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(valor) > -1);
                });
            });

            $('#filtroEstatus').on('change', function () {
                const valor = $(this).val();
                if (!valor) {
                    $('#tblManifiestos tbody tr').show();
                } else {
                    $('#tblManifiestos tbody tr').filter(function () {
                        const estatus = $(this).find('td:nth-child(7) .badge').text().trim();
                        $(this).toggle(estatus === valor);
                    });
                }
            });
        });

        function cargarManifiestos() {
            fetch('@Url.Action("GetManifiestos", "Manifiestos")', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        manifiestos = res.data || [];
                        renderizarTabla();
                    } else {
                        $('#tbManifiestos').html(`<tr><td colspan="8" class="text-center text-danger py-4">${res.error || 'Error al cargar'}</td></tr>`);
                    }
                })
                .catch(e => {
                    console.error(e);
                    $('#tbManifiestos').html('<tr><td colspan="8" class="text-center text-danger py-4">Error al cargar datos</td></tr>');
                });
        }

        function renderizarTabla() {
            $('#lblCount').text(`${manifiestos.length} manifiestos registrados`);
            if (manifiestos.length === 0) {
                $('#tbManifiestos').html('<tr><td colspan="8" class="text-center py-4">No hay manifiestos registrados.</td></tr>');
                return;
            }

            const estilosEstatus = {
                'Entregado': 'badge-activo',
                'En tránsito': 'badge-cotizacion',
                'Cancelado': 'badge-rechazado'
            };

            let html = '';
            manifiestos.forEach(m => {
                const estClass = estilosEstatus[m.estatus] || 'badge-activo';
                html += `
                    <tr>
                        <td style="font-weight:700;">${m.folio}</td>
                        <td>${m.fecha}</td>
                        <td>${m.generador}</td>
                        <td>${m.transportista}</td>
                        <td>${m.destino}</td>
                        <td style="text-align:center;">${m.volumen}</td>
                        <td style="text-align:center;"><span class="badge ${estClass}" style="font-size:11px;">${m.estatus}</span></td>
                        <td style="text-align:center;">
                            <div style="display:flex; gap:8px; justify-content:center;">
                                <button class="btn-custom btn-ghost-custom btn-sm-custom" title="Ver" onclick="verManifiesto(${m.id})">👁</button>
                                <button class="btn-custom btn-ghost-custom btn-sm-custom" title="Descargar PDF" onclick="descargarManifiesto(${m.id})">📄</button>
                            </div>
                        </td>
                    </tr>`;
            });
            $('#tbManifiestos').html(html);
        }

        function abrirModalManifiesto() {
            $('#mFolio').val('');
            $('#mFecha').val('');
            $('#mGenerador').val('');
            $('#mTransportista').val('');
            $('#mDestino').val('');
            $('#mVolumen').val('');
            $('#mEstatus').val('');
            $('#modalManifiestoOverlay').addClass('show');
        }

        function cerrarModalManifiesto(e) {
            if (e && e.target !== document.getElementById('modalManifiestoOverlay') && e.target.closest('.modal-manifiesto-box')) return;
            $('#modalManifiestoOverlay').removeClass('show');
        }

        function guardarManifiesto() {
            const datos = {
                folio: $('#mFolio').val().trim(),
                fecha: $('#mFecha').val(),
                generador: $('#mGenerador').val().trim(),
                transportista: $('#mTransportista').val().trim(),
                destino: $('#mDestino').val().trim(),
                volumen: parseFloat($('#mVolumen').val() || 0),
                estatus: $('#mEstatus').val()
            };

            if (!datos.folio || !datos.fecha || !datos.generador || !datos.transportista || !datos.destino || !datos.estatus) {
                Swal.fire('Atenci&oacute;n', 'Completa todos los campos obligatorios.', 'warning');
                return;
            }
            if (isNaN(datos.volumen) || datos.volumen < 0) {
                Swal.fire('Atenci&oacute;n', 'El volumen debe ser un n&uacute;mero mayor o igual a 0.', 'warning');
                return;
            }

            fetch('@Url.Action("Guardar", "Manifiestos")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(datos)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    $('#modalManifiestoOverlay').removeClass('show');
                    Swal.fire('Guardado', res.message, 'success').then(() => cargarManifiestos());
                } else {
                    Swal.fire('Error', res.error, 'error');
                }
            })
            .catch(e => {
                console.error(e);
                Swal.fire('Error', 'No se pudo guardar el manifiesto.', 'error');
            });
        }

        function verManifiesto(id) {
            const m = manifiestos.find(x => x.id === id);
            if (!m) return;
            Swal.fire({
                title: `Manifiesto ${m.folio}`,
                html: `
                    <div style="text-align:left; font-size:13px;">
                        <b>Fecha:</b> ${m.fecha}<br>
                        <b>Generador:</b> ${m.generador}<br>
                        <b>Transportista:</b> ${m.transportista}<br>
                        <b>Destino final:</b> ${m.destino}<br>
                        <b>Volumen:</b> ${m.volumen} ton<br>
                        <b>Estatus:</b> ${m.estatus}<br>
                    </div>`,
                confirmButtonText: 'Cerrar',
                confirmButtonColor: '#4E342E'
            });
        }

        function descargarManifiesto(id) {
            const m = manifiestos.find(x => x.id === id);
            if (!m) return;
            const contenido = `MANIFIESTO DE RECOLECCIÓN\n\nFolio: ${m.folio}\nFecha: ${m.fecha}\nGenerador: ${m.generador}\nTransportista: ${m.transportista}\nDestino final: ${m.destino}\nVolumen: ${m.volumen} ton\nEstatus: ${m.estatus}`;
            const blob = new Blob([contenido], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${m.folio}.txt`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && $('#modalManifiestoOverlay').hasClass('show')) {
                cerrarModalManifiesto();
            }
        });
    </script>
}
