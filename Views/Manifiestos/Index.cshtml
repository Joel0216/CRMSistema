@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Manifiestos";
    ViewBag.ActiveMenu = "Manifiestos";
}

<div class="page-header">
    <div>
        <h2 class="section-title">📄 Manifiestos</h2>
        <p class="section-sub">Registra y controla los manifiestos de entrega, recepción y transporte.</p>
    </div>
    <a href="@Url.Action("Nuevo")" class="btn-custom btn-primary-custom">
        + Nuevo manifiesto
    </a>
</div>

<div class="search-bar">
    <div class="search-wrap">
        <span class="search-icon">&#128269;</span>
        <input type="text" class="form-input" placeholder="Buscar manifiesto...">
    </div>
    <select class="form-input" style="width: 200px;">
        <option>Todos los estatus</option>
        <option>Entregado</option>
        <option>En tránsito</option>
        <option>Cancelado</option>
    </select>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>NÚMERO</th>
                    <th>FECHA</th>
                    <th>GENERADOR</th>
                    <th>TRANSPORTISTA</th>
                    <th>DESTINO FINAL</th>
                    <th style="text-align: center;">ESTATUS</th>
                    <th style="text-align: center;">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>MAN-2023-001</strong></td>
                    <td>15/11/2023</td>
                    <td style="font-weight: 600;">Empresa Industrial S.A.</td>
                    <td>Transportes Seguros S.A.</td>
                    <td>Relleno Sanitario Norte</td>
                    <td style="text-align: center;"><span class="badge badge-activo">Entregado</span></td>
                    <td style="text-align: center;">
                        <div style="display: flex; gap: 8px; justify-content: center;">
                            <button class="btn-custom btn-ghost-custom btn-sm-custom" title="Ver">👁</button>
                            <button class="btn-custom btn-ghost-custom btn-sm-custom" title="Descargar PDF">📄</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
