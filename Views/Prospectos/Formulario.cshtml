@model CRMSistema.Models.ViewModels.ProspectoViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = (ViewBag.Accion as string ?? "Nuevo") == "Nuevo" ? "Nuevo prospecto" : "Editar prospecto";
    ViewBag.ActiveMenu = "Prospectos";
}

<div style="padding: 24px;">
    @Html.Partial("~/Views/Prospectos/_FormularioProspecto.cshtml", Model)
    @Html.Partial("~/Views/Prospectos/_ModalContacto.cshtml")
    @Html.Partial("~/Views/Prospectos/_ModalSucursal.cshtml")
</div>

@section scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/Scripts/prospectos.js?v=21"></script>
}
