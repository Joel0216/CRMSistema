@model CRMSistema.Models.ViewModels.ProspectoViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = Model.Nombre ?? "Detalle de prospecto";
    ViewBag.Accion = "Detalle";
}

@Html.Partial("_FormularioProspecto", Model)
@Html.Partial("_ModalContacto")
@Html.Partial("_ModalSucursal")

<!-- Simular el fondo del Prospectos -->
<div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; padding: 24px; z-index: 1;">
    <div class="page-header">
        <div>
            <h2 class="section-title">Prospectos</h2>
            <p class="section-sub">Registros en total</p>
        </div>
        <button type="button" class="btn-custom btn-primary-custom" disabled>
            + Agregar Prospecto
        </button>
    </div>
    <div class="card" style="opacity: 0.6; pointer-events: none; height: calc(100vh - 200px);">
        <div class="table-wrap" style="height: 100%; background: #fff;"></div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        window.contactosIniciales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Contactos ?? new List<CRMSistema.Models.ViewModels.ProspectoContactoViewModel>()));
        window.sucursalesIniciales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Sucursales ?? new List<CRMSistema.Models.ViewModels.ProspectoSucursalViewModel>()));
        window.esModoDetalle = true;
    </script>
    <script src="~/Scripts/prospectos.js?v=21"></script>
    <script>
        $(function () {
            // Mostrar modal
            document.getElementById('modalFormularioProspecto').style.display = 'flex';
            
            // Ajustar UI para modo solo lectura
            $('.modal-title').text('Detalle del Prospecto');
            
            // Mostrar botones de acción y ocultar botón Guardar
            document.getElementById('btnAccionesDetalle').style.display = 'flex';
            $('#btnProspectoGuardar').remove();
            
            // Desactivar todos los inputs
            $('#frmProspecto input, #frmProspecto select, #frmProspecto textarea').prop('disabled', true);

            // Deshabilitar botón de verificar dirección en modo solo lectura
            $('#frmProspecto button[onclick*="verificarDireccion(\'form\')"]').prop('disabled', true);

            // Ocultar botones de agregar
            $('#btnAgregarContacto, #btnAgregarSucursal').hide();

            // Deshabilitar click en fotoSlots
            $('[id^=fotoSlot], #docCatastralSlot').css('cursor', 'default').removeAttr('onclick');

            // Cambiar texto a Cancelar
            $('#btnProspectoCancelar').text('Volver').css({'background': '#EBF5FB', 'color': '#2874A6', 'border': 'none', 'font-weight': '600'});
            $('#btnProspectoCancelar').attr('href', '@Url.Action("Index")');

            // Asegurarnos de renderizar las listas con los botones ocultos
            if (typeof renderContactos === 'function') renderContactos();
            if (typeof renderSucursales === 'function') renderSucursales();

            // Inicializar mapa de matriz en solo lectura si hay coordenadas guardadas
            var latMatriz = parseFloat(($('#Lat').val() || '').replace(',', '.'));
            var lngMatriz = parseFloat(($('#Lng').val() || '').replace(',', '.'));
            if (!isNaN(latMatriz) && !isNaN(lngMatriz)) {
                setTimeout(function() {
                    if (typeof window.inicializarMapaLeaflet === 'function') {
                        window.inicializarMapaLeaflet('form', latMatriz, lngMatriz, '', true);
                    }
                }, 200);
            }

            // Llenar previews de matriz si hay Base64 (las properties del model ya están en los hidden)
            var fachada = $('#hdnFotoFachada').val();
            var acceso = $('#hdnFotoAcceso').val();
            var ref = $('#hdnFotoReferencia').val();
            var doc = $('#hdnDocumentoCatastral').val();
            var docNom = $('#hdnDocumentoCatastralNombre').val();
            
            if (fachada) { $('#fotoPreview1').show().attr('src', fachada.startsWith('data:') ? fachada : 'data:image/jpeg;base64,' + fachada); $('#fotoPlaceholder1').hide(); $('#fotoSlot1').css('border', '2px solid #C4A574'); }
            if (acceso) { $('#fotoPreview2').show().attr('src', acceso.startsWith('data:') ? acceso : 'data:image/jpeg;base64,' + acceso); $('#fotoPlaceholder2').hide(); $('#fotoSlot2').css('border', '2px solid #C4A574'); }
            if (ref) { $('#fotoPreview3').show().attr('src', ref.startsWith('data:') ? ref : 'data:image/jpeg;base64,' + ref); $('#fotoPlaceholder3').hide(); $('#fotoSlot3').css('border', '2px solid #C4A574'); }
            
            if (doc) {
                $('#docCatastralNombreTexto').text(docNom || 'documento.pdf');
                $('#docCatastralNombre').show();
                $('#docCatastralPlaceholder').hide();
                $('#docCatastralSlot').css('border', '2px solid #27AE60');
                
                // Hacerlo descargable
                var docLink = document.createElement('a');
                docLink.href = doc.startsWith('data:') ? doc : 'data:application/pdf;base64,' + doc;
                docLink.download = docNom || 'documento.pdf';
                docLink.innerHTML = '<i class="fas fa-download"></i> Descargar documento';
                docLink.style.display = 'block';
                docLink.style.marginTop = '10px';
                docLink.style.fontSize = '12px';
                docLink.style.color = '#27AE60';
                docLink.style.textDecoration = 'none';
                document.getElementById('docCatastralNombre').appendChild(docLink);
            }
        });
    </script>
}
