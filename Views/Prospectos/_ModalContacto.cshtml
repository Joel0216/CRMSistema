<div id="modalContacto" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1050;">
    <div style="background: var(--card); border-radius: 14px; width: 450px; max-width: 90%; box-shadow: var(--shadow-lg); overflow: hidden;">
        <div class="modal-header" style="background: var(--brown-dark); padding: 16px 24px; color: white; display: flex; justify-content: space-between; align-items: center;">
            <span class="modal-contacto-titulo" style="font-weight: 700; font-size: 15px;">AGREGAR CONTACTO</span>
            <button type="button" style="background: rgba(255,255,255,0.2); border: none; color: white; border-radius: 6px; padding: 4px 12px; cursor: pointer;" data-cerrar="modalContacto">Cerrar</button>
        </div>
        
        <div style="padding: 24px;">
            <!-- MODO EDICIÓN -->
            <div id="modalContactoEdit">
                <div style="display: grid; grid-template-columns: 1fr; gap: 16px;">
                    <div class="form-group">
                        <label for="contactoNombre" class="form-label">Nombre completo *</label>
                        <input type="text" id="contactoNombre" class="form-input" placeholder="Ej. Juan Pérez" />
                    </div>
                    <div class="form-group">
                        <label for="contactoCorreo" class="form-label">Correo electr&oacute;nico *</label>
                        <input type="email" id="contactoCorreo" class="form-input" placeholder="correo@ejemplo.com" />
                    </div>
                    <div class="form-group">
                        <label for="contactoTelefono" class="form-label">Tel&eacute;fono *</label>
                        <input type="tel" id="contactoTelefono" class="form-input" placeholder="000 000 0000" oninput="this.value=this.value.replace(/[^0-9]/g,'')" minlength="10" maxlength="10" />
                    </div>
                    <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" id="contactoRepresentante" style="width: 18px; height: 18px; cursor: pointer;" />
                        <label for="contactoRepresentante" style="font-size: 13.5px; font-weight: 600; color: var(--text2); cursor: pointer; margin: 0;">Representante legal</label>
                    </div>
                </div>
                
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
                    <button type="button" class="btn-custom btn-ghost-custom" data-cerrar="modalContacto" style="padding: 9px 24px;">Cancelar</button>
                    <button type="button" class="btn-custom" id="btnGuardarContacto" style="background: var(--brown-dark); color: white; padding: 9px 24px;">Guardar</button>
                </div>
            </div>

            <!-- MODO LECTURA -->
            <div id="modalContactoView" style="display: none;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
                    <div>
                        <div style="font-size: 11px; font-weight: 700; color: var(--text3); text-transform: uppercase; margin-bottom: 4px;">Nombre de contacto</div>
                        <div id="viewContactoNombre" style="font-size: 14px; font-weight: 600; color: var(--text1);"></div>
                    </div>
                    <div>
                        <div style="font-size: 11px; font-weight: 700; color: var(--text3); text-transform: uppercase; margin-bottom: 4px;">Representante Legal</div>
                        <div id="viewContactoRep" style="font-size: 14px; font-weight: 600; color: var(--text1);"></div>
                    </div>
                    <div>
                        <div style="font-size: 11px; font-weight: 700; color: var(--text3); text-transform: uppercase; margin-bottom: 4px;">Correo</div>
                        <div id="viewContactoCorreo" style="font-size: 14px; font-weight: 600; color: var(--text1);"></div>
                    </div>
                    <div>
                        <div style="font-size: 11px; font-weight: 700; color: var(--text3); text-transform: uppercase; margin-bottom: 4px;">Teléfono</div>
                        <div id="viewContactoTelefono" style="font-size: 14px; font-weight: 600; color: var(--text1);"></div>
                    </div>
                </div>
                <div style="display: flex; justify-content: center;">
                    <button type="button" class="btn-custom" data-cerrar="modalContacto" style="background: var(--brown-dark); color: white; padding: 10px 40px; text-transform: uppercase; font-weight: 700;">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>
