@model CRMSistema.Models.ViewModels.ProspectoViewModel
@{
    var accion = ViewBag.Accion as string ?? "Nuevo";
    var esNuevo = accion == "Nuevo";
}

<style>
    .tab-item { padding: 16px 0; color: var(--text3); font-weight: 600; cursor: pointer; font-size: 13.5px; border-bottom: 2px solid transparent; }
    .tab-item.active { color: var(--brown-dark); font-weight: 700; border-bottom-color: var(--brown-dark); }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .section-title-sm { font-size: 11px; font-weight: 700; color: var(--text2); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 16px; border-bottom: 1px solid var(--border-light); padding-bottom: 6px; }
</style>

<div id="modalFormularioProspecto" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1040;">
    <div style="background: white; border-radius: 14px; width: 850px; max-width: 95%; max-height: 95vh; display: flex; flex-direction: column; box-shadow: var(--shadow-lg); overflow: hidden;">
        <div class="modal-header" style="flex-shrink: 0;">
            <span class="modal-title">
                @(accion == "Detalle" ? "Detalle del Prospecto" : (esNuevo ? "Nuevo Prospecto" : "Editar Prospecto"))
            </span>
            <button type="button" class="btn btn-sm" data-cerrar="modalPrincipal" style="background: rgba(255,255,255,0.2); color: white; text-decoration: none; border-radius: 6px; padding: 4px 12px; border: none; cursor: pointer;">Cerrar</button>
        </div>

    @using (Html.BeginForm(accion, "Prospectos", FormMethod.Post, new { @enctype = "multipart/form-data", id = "frmProspecto", style = "display: flex; flex-direction: column; flex-grow: 1; overflow: hidden;" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.FotoFachada, new { id = "hdnFotoFachada" })
        @Html.HiddenFor(m => m.FotoAcceso, new { id = "hdnFotoAcceso" })
        @Html.HiddenFor(m => m.FotoReferencia, new { id = "hdnFotoReferencia" })
        @Html.HiddenFor(m => m.DocumentoCatastral, new { id = "hdnDocumentoCatastral" })
        @Html.HiddenFor(m => m.DocumentoCatastralNombre, new { id = "hdnDocumentoCatastralNombre" })


        <div class="modal-body" style="background: var(--card); padding: 0; overflow-y: auto; flex-grow: 1;">
            <div style="display: flex; gap: 24px; padding: 0 24px; border-bottom: 1px solid var(--border-light); margin-bottom: 24px;">
                <div class="tab-item active" onclick="showTab('datos', this)">Datos Personales</div>
                <div class="tab-item" onclick="showTab('direccion', this)">Direcci&oacute;n</div>
                <div class="tab-item" onclick="showTab('fotos', this)">Fotos</div>
            </div>

            <div style="padding: 0 24px 24px;">
                <!-- TAB 1: DATOS PERSONALES -->
                <div id="tab-datos" class="tab-content active">
                    <div class="section-title-sm">INFORMACI&Oacute;N (MATRIZ)</div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label class="form-label" for="TipoPersona">Tipo de persona *</label>
                            @Html.DropDownListFor(m => m.TipoPersona, new SelectList((string[])ViewBag.TiposPersona), new { @class = "form-input" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Nombre">Raz&oacute;n Social / Nombre completo *</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-input", placeholder = "Ej. Empresa SA de CV" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Rfc">RFC *</label>
                            @Html.TextBoxFor(m => m.Rfc, new { @class = "form-input", placeholder = "XAXX010101000" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="NombreComercial">Nombre Comercial *</label>
                            @Html.TextBoxFor(m => m.NombreComercial, new { @class = "form-input", placeholder = "Ej. Empresa" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="TieneSucursales">&iquest;Tiene sucursales?</label>
                            @Html.DropDownListFor(m => m.TieneSucursales, new SelectList((string[])ViewBag.SiNo), new { @class = "form-input" })
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nombre completo de contacto *</label>
                            @Html.TextBoxFor(m => m.Contacto, new { @class = "form-input", placeholder = "Ej. Juan P\u00E9rez Solis" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Telefono">Tel&eacute;fono de contacto *</label>
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-input", placeholder = "999 000 0000", type = "tel", oninput = "this.value=this.value.replace(/[^0-9]/g,'')", maxlength = "10" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Email">Correo electr&oacute;nico *</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "correo@ejemplo.com" })
                        </div>
                    </div>

                    <div class="section-title-sm" style="margin-top: 32px; display: flex; align-items: center; cursor: pointer;">
                        <i class="fas fa-chevron-down me-2" style="font-size: 10px;"></i> DATOS DE CONTACTO
                    </div>
                    
                    <!-- Aquí se renderizan los contactos -->
                    <div id="listaContactos" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;"></div>
                    <input type="hidden" name="jsonContactos" id="hdnContactos" value="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.Contactos ?? new List<CRMSistema.Models.ViewModels.ProspectoContactoViewModel>())" />

                    @if (accion != "Detalle")
                    {
                        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; border-top: 1px solid var(--border-light); padding-top: 16px;">
                            <button type="button" id="btnAgregarContacto" class="btn-custom btn-primary-custom" style="padding: 6px 14px; font-size: 12px; border-radius: 6px;">+ Agregar Contacto</button>
                        </div>
                    }

                    <!-- ESTADO DEL PROSPECTO (SOLO DETALLE) -->
                    <div id="seccionEstadoDetalle" style="display: none; margin-top: 24px; padding: 16px; background: #F8F9FA; border-radius: 8px; border: 1px solid var(--border-light);">
                        <div class="section-title-sm" style="margin-bottom: 12px;">ESTATUS</div>
                        <div id="badgeContainerDetalle" style="margin-bottom: 12px;">
                            @Html.Partial("~/Views/Prospectos/_BadgeEstatus.cshtml", Model.Estatus ?? "Nuevo")
                        </div>
                        <div id="motivoRechazoDetalle" style="display: none; margin-top: 12px;">
                            <div style="font-size: 11px; font-weight: 600; color: var(--text3); margin-bottom: 4px; text-transform: uppercase;">Motivo de Rechazo</div>
                            <div style="font-size: 13px; color: var(--text1); background: white; padding: 8px 12px; border-radius: 6px; border: 1px solid #FADBD8;">@Model.MotivoRechazo</div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: DIRECCI&Oacute;N -->
                <div id="tab-direccion" class="tab-content">
                    <div style="margin-bottom: 16px; background: var(--bg2, #F8F9FA); padding: 12px; border-radius: 8px; border: 1px solid var(--border-light);">
                        <div style="font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--text1);">B&uacute;squeda r&aacute;pida en mapa</div>
                        <input type="text" id="busquedaMapa" class="form-input" style="width: 100%;" placeholder="Pega todo junto aqu&iacute;. Ej: C. 60-A 322-por 57 y 59, Mulchechen, 97370 M&eacute;rida, Yuc." />
                        <div style="font-size: 11px; color: var(--text3); margin-top: 4px;">Si llenas este campo, el mapa lo usar&aacute; como primera opci&oacute;n para encontrar la ubicaci&oacute;n exacta.</div>
                    </div>
                    
                    <div class="section-title-sm">DIRECCI&Oacute;N (MATRIZ)</div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label class="form-label" for="Calle">Calle</label>
                            @Html.TextBoxFor(m => m.Calle, new { @class = "form-input", placeholder = "Ej. Av. Paseo de Montejo" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="NumExt">Numero Exterior</label>
                            @Html.TextBoxFor(m => m.NumExt, new { @class = "form-input", placeholder = "Ej. 100" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="NumInt">Numero Interior</label>
                            @Html.TextBoxFor(m => m.NumInt, new { @class = "form-input", placeholder = "Ej. Depto 2" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Colonia">Colonia</label> 
                            @Html.TextBoxFor(m => m.Colonia, new { @class = "form-input", placeholder = "Ej. Centro" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Municipio">Municipio</label>
                            @Html.TextBoxFor(m => m.Municipio, new { @class = "form-input", placeholder = "Ej. Mérida" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Cp">Codigo Postal</label>
                            @Html.TextBoxFor(m => m.Cp, new { @class = "form-input", placeholder = "Ej. 97000", onblur = "buscarCP(this.value, 'form')" })
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="Estado">Estado</label>
                            @Html.TextBoxFor(m => m.Estado, new { @class = "form-input", placeholder = "Ej. Yucatán" })
                        </div>

                        <div class="form-group" style="grid-column: 1 / -1;">
                            @Html.LabelFor(m => m.Referencias, "Referencias", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Referencias, new { @class = "form-input", placeholder = "Ej. Cerca de la plaza" })
                        </div>
                    </div>

                    <button type="button" class="btn-custom" style="background: #e2a659; color: white; margin-bottom: 12px; margin-top: 16px; padding: 8px 16px; font-size: 13px;" onclick="verificarDireccion('form')">
                        Verificar Direcci&oacute;n
                    </button>

                    <div id="mapContainer-form" style="background: var(--bg2, #F8F9FA); border-radius: 8px; height: 240px; display: flex; align-items: center; justify-content: center; color: var(--text3); font-size: 13px; border: 1px solid var(--border-light); flex-direction: column; gap: 8px; overflow: hidden;">
                        <span id="mapText-form">Llena la direcci&oacute;n y presiona <strong>Verificar</strong> para usar el mapa interactivo</span>
                        <iframe id="mapFrame-form" style="display: none; width: 100%; height: 100%; border: none;"></iframe>
                    </div>

                    <div style="background: var(--bg2, #F8F9FA); padding: 12px; border-radius: 8px; margin-top: 16px; border: 1px solid var(--border-light);">
                        <div style="font-size: 12px; font-weight: 600; margin-bottom: 8px; color: var(--text1);">Ajuste Manual de Coordenadas</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label class="form-label" for="Lat">Latitud</label>
                                @Html.TextBoxFor(m => m.Lat, new { @class = "form-input", placeholder = "Ej: 20.9674" })
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="Lng">Longitud</label>
                                @Html.TextBoxFor(m => m.Lng, new { @class = "form-input", placeholder = "Ej: -89.6237" })
                            </div>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                            <span style="font-size: 11px; color: var(--text3);">Escribe las coordenadas exactas si el mapa no fue preciso.</span>
                            <button type="button" class="btn btn-sm btn-primary-custom" style="font-size: 11px; padding: 4px 12px;">Autocompletar Direcci&oacute;n</button>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: FOTOS -->
                <div id="tab-fotos" class="tab-content">
                    <div class="section-title-sm">DOCUMENTOS Y FOTOGRAF&Iacute;AS (MATRIZ)</div>
                    <p style="font-size: 13px; color: var(--text2); margin-bottom: 16px;">Sube 3 fotograf&iacute;as que nos ayuden a ubicar e identificar correctamente tu domicilio de servicio.</p>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                        <!-- Foto 1 -->
                        <div id="fotoSlot1" onclick="document.getElementById('fotoFile1').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 20px; text-align: center; background: #FFFAF5; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                            <div id="fotoPlaceholder1"><div style="font-size: 32px; color: #C4A574; margin-bottom: 8px;"><i class="fas fa-image"></i></div><div style="font-weight: 700; font-size: 13px; color: #5C3819;">Foto 1 - Fachada</div><div style="font-size: 11px; color: #999; margin-top: 4px;">Haz clic para subir.</div></div>
                            <img id="fotoPreview1" src="#" alt="Vista previa" style="display:none;max-width:100%;max-height:130px;border-radius:8px;object-fit:cover;" />
                            <input type="file" id="fotoFile1" name="Foto1" accept="image/*" style="display:none;" onchange="previewFoto(this,'fotoPreview1','fotoPlaceholder1','fotoSlot1', 'hdnFotoFachada')" />
                        </div>
                        <!-- Foto 2 -->
                        <div id="fotoSlot2" onclick="document.getElementById('fotoFile2').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 20px; text-align: center; background: #FFFAF5; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                            <div id="fotoPlaceholder2"><div style="font-size: 32px; color: #C4A574; margin-bottom: 8px;"><i class="fas fa-image"></i></div><div style="font-weight: 700; font-size: 13px; color: #5C3819;">Foto 2 - Acceso</div><div style="font-size: 11px; color: #999; margin-top: 4px;">Haz clic para subir.</div></div>
                            <img id="fotoPreview2" src="#" alt="Vista previa" style="display:none;max-width:100%;max-height:130px;border-radius:8px;object-fit:cover;" />
                            <input type="file" id="fotoFile2" name="Foto2" accept="image/*" style="display:none;" onchange="previewFoto(this,'fotoPreview2','fotoPlaceholder2','fotoSlot2', 'hdnFotoAcceso')" />
                        </div>
                        <!-- Foto 3 -->
                        <div id="fotoSlot3" onclick="document.getElementById('fotoFile3').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 20px; text-align: center; background: #FFFAF5; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                            <div id="fotoPlaceholder3"><div style="font-size: 32px; color: #C4A574; margin-bottom: 8px;"><i class="fas fa-image"></i></div><div style="font-weight: 700; font-size: 13px; color: #5C3819;">Foto 3 - Referencia</div><div style="font-size: 11px; color: #999; margin-top: 4px;">Haz clic para subir.</div></div>
                            <img id="fotoPreview3" src="#" alt="Vista previa" style="display:none;max-width:100%;max-height:130px;border-radius:8px;object-fit:cover;" />
                            <input type="file" id="fotoFile3" name="Foto3" accept="image/*" style="display:none;" onchange="previewFoto(this,'fotoPreview3','fotoPlaceholder3','fotoSlot3', 'hdnFotoReferencia')" />
                        </div>
                    </div>

                    <!-- NUEVOS CAMPOS: Folio Catastral y Documento Catastral -->
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label class="form-label" for="FolioCatastral">Folio Catastral</label>
                        @Html.TextBoxFor(m => m.FolioCatastral, new { @class = "form-input", placeholder = "Escribe tu Folio Catastral" })
                    </div>

                    <p style="font-size: 12px; color: var(--text3); margin-bottom: 8px;">Sube tu documento Catastral:</p>
                    <div id="docCatastralSlot" onclick="document.getElementById('docCatastralFile').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 24px; text-align: center; background: #FFFAF5; cursor: pointer; position: relative;">
                        <div id="docCatastralPlaceholder">
                            <div style="font-size: 32px; margin-bottom: 8px; color: #C4A574;"><i class="fas fa-file-pdf"></i></div>
                            <div style="font-weight: 700; font-size: 14px; color: #5C3819;">Arrastra tu Folio Catastral aquí</div>
                            <div style="font-size: 12px; color: #999; margin-top: 4px;">o haz click para seleccionar el archivo<br>PDF, JPG o PNG</div>
                        </div>
                        <div id="docCatastralNombre" style="display:none; font-size:13px; color:#5C3819; font-weight:600;"><i class="fas fa-check-circle" style="color:#27AE60;margin-right:6px;"></i><span id="docCatastralNombreTexto"></span></div>
                        <input type="file" id="docCatastralFile" name="DocumentoCatastralFile" accept="application/pdf,image/*" style="display:none;" onchange="previewDoc(this,'docCatastralNombre','docCatastralPlaceholder','docCatastralNombreTexto','docCatastralSlot', 'hdnDocumentoCatastral', 'hdnDocumentoCatastralNombre')" />
                    </div>

                    <div id="seccion-sucursales" style="margin-top: 32px; border-top: 1px solid var(--border-light); padding-top: 24px; display: @(Model.TieneSucursales == "Sí" || Model.TieneSucursales == "Si" ? "block" : "none");">
                        <div class="section-title-sm" style="display: flex; align-items: center; cursor: pointer;">
                            <i class="fas fa-chevron-down me-2" style="font-size: 10px;"></i> GESTI&Oacute;N DE SUCURSALES
                        </div>
                        
                        <div id="listaSucursales" style="display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 16px;"></div>
                        <input type="hidden" name="jsonSucursales" id="hdnSucursales" value="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.Sucursales ?? new List<CRMSistema.Models.ViewModels.ProspectoSucursalViewModel>())" />

                        @if (accion != "Detalle")
                        {
                            <div style="background: #EBF5FB; border-radius: 8px; padding: 16px; border: 1px solid #D6EAF8; margin-top: 16px;">
                                <div style="font-size: 12px; color: #2874A6; font-weight: 500;">
                                    A&ntilde;ade aqu&iacute; las sucursales vinculadas a este prospecto. Aseg&uacute;rate de subir sus fotos y documentos correspondientes.
                                </div>
                            </div>
                            <div style="text-align: right; margin-top: 12px;">
                                <button type="button" id="btnAgregarSucursal" class="btn-custom" style="background: var(--brown-dark); color: white; padding: 6px 14px; font-size: 12px; border-radius: 6px;">+ Agregar Sucursal</button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Form Actions -->
                <div style="display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; border-top: 1px solid var(--border-light); padding-top: 16px;">
                    <div id="btnAccionesDetalle" style="display: none; gap: 12px;">
                        <button type="button" class="btn-custom" style="background: #C0392B; color: white; padding: 9px 24px;" data-accion="rechazar" data-id="@Model.Id">Rechazar</button>
                        <button type="button" class="btn-custom" style="background: #E67E22; color: white; padding: 9px 24px;" data-accion="asignar" data-id="@Model.Id">Asignar Vendedor</button>
                        <button type="button" class="btn-custom btn-ghost-custom" style="color: #C0392B; border-color: #C0392B; padding: 9px 24px;" data-accion="baja" data-id="@Model.Id">Dar de Baja</button>
                    </div>
                    <div id="btnNavegacionFormulario" style="display: flex; gap: 12px; margin-left: auto;">
                        <button type="button" id="btnProspectoAnterior" class="btn-custom btn-ghost-custom" style="padding: 9px 24px; display: none;" data-nav="-1">Anterior</button>
                        <button type="button" id="btnProspectoCancelar" class="btn-custom btn-ghost-custom" style="padding: 9px 24px;" data-cerrar="modalPrincipal">Cancelar</button>
                        <button type="button" id="btnProspectoSiguiente" class="btn-custom btn-primary-custom" style="padding: 9px 24px;" data-nav="1">Siguiente</button>
                        <button type="submit" id="btnProspectoGuardar" class="btn-custom btn-primary-custom" style="padding: 9px 24px; display: none;">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script>
        window.contactosIniciales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Contactos ?? new List<CRMSistema.Models.ViewModels.ProspectoContactoViewModel>()));
        window.sucursalesIniciales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Sucursales ?? new List<CRMSistema.Models.ViewModels.ProspectoSucursalViewModel>()));
    </script>
</div>

@Html.Partial("~/Views/Prospectos/_ModalContacto.cshtml")
@Html.Partial("~/Views/Prospectos/_ModalSucursal.cshtml")

