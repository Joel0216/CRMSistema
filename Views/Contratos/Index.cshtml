@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Contratos";
    ViewBag.ActiveMenu = "Contratos";
}

<style>
    .contrato-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.55);
        align-items: center;
        justify-content: center;
        z-index: 1040;
        padding: 0;
    }
    .contrato-overlay.show { display: flex; }

    .contrato-box {
        background: white;
        border-radius: 0;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    @@media (min-width: 768px) {
        .contrato-box {
            border-radius: 14px;
            width: 1150px;
            max-width: 96%;
            max-height: 96vh;
            height: auto;
        }
    }

    @@media (min-width: 1400px) {
        .contrato-box {
            width: 1400px;
        }
    }

    .contrato-body {
        padding: 28px 32px;
        overflow-y: auto;
        flex-grow: 1;
    }

    .seccion-titulo {
        color: #D84315;
        font-size: 13px;
        font-weight: 700;
        border-bottom: 1px solid #eee;
        padding-bottom: 8px;
        margin-bottom: 16px;
        margin-top: 24px;
    }

    .campo-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .campo-readonly {
        width: 100%;
        padding: 6px 10px;
        font-size: 12px;
        border: 1px solid #E0E0E0;
        border-radius: 4px;
        background: #FAFAFA;
        color: #424242;
    }

    .servicios-tabla {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #4E342E;
        font-size: 11px;
        text-align: left;
        margin-bottom: 24px;
    }
    .servicios-tabla thead { background: #8D6E63; color: white; }
    .servicios-tabla th, .servicios-tabla td { padding: 8px; border: 1px solid #4E342E; }
    .servicios-tabla tbody { background: #fff; color: #333; }

    .badge-tipo {
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 11px;
    }

    .badge-dia {
        padding: 1px 4px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 10px;
    }

    .summary-box {
        width: 400px;
        margin-left: auto;
        border: 1px solid #C4A574;
        border-radius: 8px;
        padding: 16px;
        background: #FFFDE7;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        background: #3E2723;
        color: white;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: bold;
        margin: 16px -16px -16px -16px;
        border-radius: 0 0 8px 8px;
    }

    .linea-firma {
        border-bottom: 1px solid #333;
        height: 40px;
    }

    .leyenda-card {
        width: 320px;
        padding: 20px;
        background: #fafafa;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
    }

    .btn-enviar {
        background: #D84315;
        color: white;
        border: none;
        padding: 8px 24px;
        font-weight: 700;
        border-radius: 6px;
    }
    .btn-enviar:hover { background: #BF360C; }

    .btn-reenviar {
        background: #4E342E;
        color: white;
        border: none;
        padding: 8px 24px;
        font-weight: 700;
        border-radius: 6px;
    }
    .btn-reenviar:hover { background: #3E2723; }

    .btn-precontrato {
        background: #fff;
        color: #D84315;
        border: 1px solid #D84315;
        padding: 10px 22px;
        font-weight: 700;
        border-radius: 6px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-precontrato:hover { background: #FFF3E0; }

    .btn-pdf {
        background: #fff;
        color: #4E342E;
        border: 1px solid #4E342E;
        padding: 10px 22px;
        font-weight: 700;
        border-radius: 6px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-pdf:hover { background: #F5F5F5; }

    .contrato-footer {
        border-top: 1px solid #eee;
        justify-content: space-between;
        flex-shrink: 0;
        gap: 12px;
        padding: 16px 32px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    .contrato-footer .grupo-botones {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    @@media (max-width: 768px) {
        .contrato-footer { flex-direction: column; align-items: stretch; }
        .contrato-footer .grupo-botones { justify-content: flex-end; }
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="section-title mb-0" style="text-transform: uppercase;">Contratos</h2>
        <p class="section-sub mb-0" id="lblCount">Cargando...</p>
    </div>
</div>

<div class="search-bar mb-4">
    <div class="search-wrap">
        <i class="fas fa-search search-icon"></i>
        <input type="text" class="form-input" id="txtBuscar" placeholder="Buscar contrato...">
    </div>
    <select class="form-input" id="cbxEstatus" style="width: 200px;">
        <option value="">Todos los estatus</option>
        <option value="Por Autorizar">Por Autorizar</option>
        <option value="Activo">Por firmar</option>
        <option value="Enviado">Enviado</option>
        <option value="Firmado">Firmado</option>
        <option value="Rechazado">Rechazado</option>
    </select>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="table" id="tblContratos">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Fecha Autorización</th>
                    <th>Cliente</th>
                    <th>RFC</th>
                    <th>Monto Mensual</th>
                    <th>Estatus</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbContratos">
                <tr><td colspan="7" class="text-center py-4">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Contrato -->
<div id="modalContrato" class="contrato-overlay" onclick="if(event.target === this) cerrarModal()">
    <div class="contrato-box">
        <div class="modal-header" style="background: #3E2723; color: white; border-bottom: none; flex-shrink: 0;">
            <h5 class="modal-title" id="modalTitulo" style="font-size: 16px; text-transform: uppercase;">CONTRATO</h5>
            <button type="button" class="btn btn-sm" onclick="cerrarModal()" style="background: rgba(255,255,255,0.2); color: white; border: none; border-radius: 6px; padding: 4px 12px; font-weight: 600;">Cerrar</button>
        </div>
        <div class="contrato-body">
            <div id="alertaRechazo" class="alert alert-danger mb-3" style="display: none; font-size: 12px;">
                <strong><i class="fas fa-exclamation-circle"></i> Contrato rechazado:</strong> <span id="txtMotivoRechazo"></span>
                <div style="font-size: 11px; color: #888; margin-top: 4px;">Rechazado por <span id="txtUsuarioRechazo"></span> — <span id="txtFechaRechazo"></span></div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 mb-2">
                    <label class="campo-label">Folio de Contrato</label>
                    <input type="text" class="campo-readonly" id="detFolio" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">Fecha de Autorización</label>
                    <input type="text" class="campo-readonly" id="detFecha" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">Estatus</label>
                    <input type="text" class="campo-readonly" id="detEstatus" readonly>
                </div>
            </div>

            <div class="seccion-titulo">DATOS DEL PRESTADOR DE SERVICIOS</div>
            <div class="row mb-3">
                <div class="col-md-4 mb-2">
                    <label class="campo-label">EMPRESA</label>
                    <input type="text" class="campo-readonly" value="SANEAMIENTO SANA" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">CIF / RFC</label>
                    <input type="text" class="campo-readonly" value="SANA010101XYZ" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">NOMBRE COMERCIAL</label>
                    <input type="text" class="campo-readonly" value="SANEAMIENTO SANA" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">TELÉFONO</label>
                    <input type="text" class="campo-readonly" value="999 000 0000" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">DOMICILIO FISCAL</label>
                    <input type="text" class="campo-readonly" value="CARRETERA MERIDA - CHALMUCH KM. 1.3" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">CORREO DE ATENCIÓN</label>
                    <input type="text" class="campo-readonly" id="detCorreoAtencion" value="" readonly>
                </div>
            </div>

            <div class="seccion-titulo">DATOS DEL CLIENTE</div>
            <div class="row mb-3">
                <div class="col-md-4 mb-2">
                    <label class="campo-label">RAZÓN SOCIAL</label>
                    <input type="text" class="campo-readonly" id="detRazonSocial" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">RFC</label>
                    <input type="text" class="campo-readonly" id="detRFC" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">NOMBRE COMERCIAL</label>
                    <input type="text" class="campo-readonly" id="detNombreComercial" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">REPRESENTANTE LEGAL</label>
                    <input type="text" class="campo-readonly" id="detRepresentante" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">DOMICILIO FISCAL</label>
                    <input type="text" class="campo-readonly" id="detDomicilioFiscal" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">DOMICILIO DE RECOLECCIÓN</label>
                    <input type="text" class="campo-readonly" id="detDomicilioRecoleccion" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">TELÉFONO DE CONTACTO</label>
                    <input type="text" class="campo-readonly" id="detTelefono" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">CORREO COMERCIAL</label>
                    <input type="text" class="campo-readonly" id="detCorreo" readonly>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">FOLIO CATASTRAL</label>
                    <input type="text" class="campo-readonly" id="detFolioCatastral" readonly>
                </div>
            </div>

            <div class="seccion-titulo">SERVICIOS COTIZADOS</div>
            <div id="serviciosContainer"></div>

            <div class="seccion-titulo">CONDICIONES DEL SERVICIO</div>
            <div style="font-size: 11px; color: #333; margin-bottom: 40px; line-height: 1.5;">
                <p style="font-weight: 700; margin-bottom: 8px;">El costo por bolsa adicional recolectado será:</p>
                <ul style="list-style-type: upper-alpha; padding-left: 20px; margin: 0; margin-bottom: 16px;">
                    <li id="condPrecioAdicional">_TAFIRA-B_ pesos más I.V.A. en _ZONA_</li>
                    <li>Factor: “unidades” equivale a 1 bolsa de 1.20 x 0.90cm.</li>
                    <li>En caso de exceder el volumen de generación establecido, se factura el excedente generado.</li>
                    <li>Contamos con certificaciones de calidad y cumplimiento ambiental.</li>
                    <li>Después de 15 días sin firma de autorización, los costos están sujetos a cambio sin previo aviso.</li>
                    <li>La primera facturación es por un semestre, posteriormente puede ser mensual o trimestral.</li>
                    <li>Contrato a un año, independientemente del periodo de pago.</li>
                    <li>Servicio colectivo de recolección de los residuos sólidos urbanos en unidad con CAJA COMPACTADORA.</li>
                    <li>Servicio proporcionado por un operador y dos recolectores.</li>
                </ul>
                <p>Agradezco la oportunidad que nos brinda de poder servirle, quedo a sus órdenes en caso de duda.</p>
            </div>

            <div style="display: flex; justify-content: space-around; margin-top: 60px; margin-bottom: 40px;">
                <div style="text-align: center; width: 300px;">
                    <div class="linea-firma"></div>
                    <div style="font-size: 11px; font-weight: 700; margin-top: 8px;">NOMBRE DEL REPRESENTANTE<br/>SANEAMIENTO SANA SA DE CV</div>
                </div>
                <div style="text-align: center; width: 300px;">
                    <div class="linea-firma"></div>
                    <div style="font-size: 11px; font-weight: 700; margin-top: 8px;">NOMBRE DEL REPRESENTANTE<br/>EMPRESA A BRINDAR SERVICIO</div>
                </div>
            </div>
        </div>
        <div class="contrato-footer">
            <div class="grupo-botones">
                <button type="button" class="btn-pdf" onclick="descargarPDF()">
                    <i class="fas fa-file-pdf"></i> DESCARGAR PDF
                </button>
            </div>
            <div class="grupo-botones">
                <button type="button" class="btn-precontrato" onclick="enviarPreContrato()">
                    <i class="fas fa-file-alt"></i> ENVIAR PRE-CONTRATO
                </button>
                <button type="button" class="btn-reenviar" onclick="reenviarContrato()">
                    <i class="fas fa-redo"></i> RE-ENVIAR
                </button>
                <button type="button" class="btn-enviar" onclick="enviarContrato()" id="btnEnviarContrato">
                    <i class="fas fa-paper-plane"></i> ENVIAR CONTRATO
                </button>
                <button type="button" class="btn-enviar" onclick="enviarRevision()" id="btnEnviarRevision" style="display:none; background:#E65100;">
                    <i class="fas fa-user-check"></i> ENVIAR A REVISIÓN
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Servicios -->
<div id="modalEditarServicios" class="contrato-overlay" onclick="if(event.target === this) cerrarModalEditar()">
    <div class="contrato-box">
        <div class="modal-header" style="background: #3E2723; color: white; border-bottom: none; flex-shrink: 0;">
            <h5 class="modal-title" style="font-size: 16px; text-transform: uppercase;">EDITAR SERVICIOS COTIZADOS</h5>
            <button type="button" class="btn btn-sm" onclick="cerrarModalEditar()" style="background: rgba(255,255,255,0.2); color: white; border: none; border-radius: 6px; padding: 4px 12px; font-weight: 600;">Cerrar</button>
        </div>
        <div class="contrato-body">
            <div class="alert alert-warning" style="font-size: 12px;">
                <i class="fas fa-info-circle"></i> Solo se pueden editar los servicios cotizados y los datos del cliente. Los datos del prestador no se modificarán.
            </div>

            <!-- DATOS DEL CLIENTE EDITABLES -->
            <div class="seccion-titulo" style="margin-top:0;">DATOS DEL CLIENTE</div>
            <div class="row mb-3">
                <div class="col-md-4 mb-2">
                    <label class="campo-label">RAZÓN SOCIAL</label>
                    <input type="text" class="form-control form-control-sm" id="editRazonSocial">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">RFC</label>
                    <input type="text" class="form-control form-control-sm" id="editRFC">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">NOMBRE COMERCIAL</label>
                    <input type="text" class="form-control form-control-sm" id="editNombreComercial">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">REPRESENTANTE LEGAL</label>
                    <input type="text" class="form-control form-control-sm" id="editRepresentante">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">DOMICILIO FISCAL</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="editDomicilioFiscal">
                        <button type="button" class="btn btn-outline-secondary" onclick="abrirModalDireccion()" title="Editar dirección y documentos">
                            <i class="fas fa-map-marker-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">DOMICILIO DE RECOLECCIÓN</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="editDomicilioRecoleccion">
                        <button type="button" class="btn btn-outline-secondary" onclick="abrirModalDireccion()" title="Editar dirección y documentos">
                            <i class="fas fa-map-marker-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">TELÉFONO DE CONTACTO</label>
                    <input type="text" class="form-control form-control-sm" id="editTelefono" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="15">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">CORREO COMERCIAL</label>
                    <input type="email" class="form-control form-control-sm" id="editCorreo">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="campo-label">FOLIO CATASTRAL</label>
                    <input type="text" class="form-control form-control-sm" id="editFolioCatastral" readonly>
                </div>
            </div>

            <div class="seccion-titulo">SERVICIOS COTIZADOS</div>
            <div id="editarServiciosContainer"></div>

            <div class="summary-box mt-4">
                <div class="summary-row"><span>SUBTOTAL SERVICIOS</span><span id="editSubtotal" style="font-weight: bold;">$0.00</span></div>
                <div class="summary-row"><span>IVA (16%)</span><span id="editIVA" style="font-weight: bold;">$0.00</span></div>
                <div class="summary-row"><span>DESCUENTO</span><span id="editDescuento" style="font-weight: bold; color: #C62828;">-$0.00</span></div>
                <div class="summary-total"><span>TOTAL MENSUAL ESTIMADO</span><span id="editTotal">$0.00</span></div>
            </div>
        </div>
        <div class="contrato-footer">
            <div class="grupo-botones">
                <button type="button" class="btn btn-outline-secondary" onclick="cerrarModalEditar()">Cancelar</button>
            </div>
            <div class="grupo-botones">
                <button type="button" class="btn-enviar" onclick="guardarServiciosEditados()">
                    <i class="fas fa-save"></i> Guardar y reenviar a autorización
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Dirección y Documentos -->
<div id="modalEditarDireccion" class="contrato-overlay" onclick="if(event.target === this) cerrarModalDireccion()">
    <div class="contrato-box" style="width: 900px;">
        <div class="modal-header" style="background: #4E342E; color: white; border-bottom: none; flex-shrink: 0;">
            <h5 class="modal-title" style="font-size: 16px; text-transform: uppercase;">EDITAR DIRECCIÓN Y DOCUMENTOS</h5>
            <button type="button" class="btn btn-sm" onclick="cerrarModalDireccion()" style="background: rgba(255,255,255,0.2); color: white; border: none; border-radius: 6px; padding: 4px 12px; font-weight: 600;">Cerrar</button>
        </div>
        <div class="contrato-body">
            <div class="seccion-titulo" style="margin-top:0;">DOMICILIO FISCAL <span class="text-muted" style="font-size:11px; font-weight:400;">(solo lectura)</span></div>
            <div class="row mb-3" style="opacity: 0.85;">
                <div class="col-md-6 mb-2"><label class="campo-label">CALLE</label><input type="text" class="form-control form-control-sm" id="dirFiscalCalle" readonly style="background:#f0f0f0;"></div>
                <div class="col-md-2 mb-2"><label class="campo-label">NÚM. EXT.</label><input type="text" class="form-control form-control-sm" id="dirFiscalNumExt" readonly style="background:#f0f0f0;"></div>
                <div class="col-md-2 mb-2"><label class="campo-label">NÚM. INT.</label><input type="text" class="form-control form-control-sm" id="dirFiscalNumInt" readonly style="background:#f0f0f0;"></div>
                <div class="col-md-2 mb-2"><label class="campo-label">C.P.</label><input type="text" class="form-control form-control-sm" id="dirFiscalCP" readonly style="background:#f0f0f0;"></div>
                <div class="col-md-4 mb-2"><label class="campo-label">COLONIA</label><input type="text" class="form-control form-control-sm" id="dirFiscalColonia" readonly style="background:#f0f0f0;"></div>
                <div class="col-md-4 mb-2"><label class="campo-label">MUNICIPIO</label><input type="text" class="form-control form-control-sm" id="dirFiscalMunicipio" readonly style="background:#f0f0f0;"></div>
                <div class="col-md-4 mb-2"><label class="campo-label">ESTADO</label><input type="text" class="form-control form-control-sm" id="dirFiscalEstado" readonly style="background:#f0f0f0;"></div>
            </div>

            <div class="seccion-titulo">DOMICILIO DE RECOLECCIÓN</div>
            <div class="row mb-3">
                <div class="col-md-6 mb-2"><label class="campo-label">CALLE</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionCalle"></div>
                <div class="col-md-2 mb-2"><label class="campo-label">NÚM. EXT.</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionNumExt"></div>
                <div class="col-md-2 mb-2"><label class="campo-label">NÚM. INT.</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionNumInt"></div>
                <div class="col-md-2 mb-2"><label class="campo-label">C.P.</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionCP" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="10"></div>
                <div class="col-md-4 mb-2"><label class="campo-label">COLONIA</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionColonia"></div>
                <div class="col-md-4 mb-2"><label class="campo-label">MUNICIPIO</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionMunicipio"></div>
                <div class="col-md-4 mb-2"><label class="campo-label">ESTADO</label><input type="text" class="form-control form-control-sm" id="dirRecoleccionEstado"></div>
            </div>

            <div class="seccion-titulo">FOLIO CATASTRAL Y ARCHIVOS</div>
            <div class="row mb-3">
                <div class="col-md-6 mb-3">
                    <label class="campo-label">FOLIO CATASTRAL</label>
                    <input type="text" class="form-control form-control-sm" id="dirFolioCatastral" placeholder="Escribe el folio catastral">
                </div>
            </div>

            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">Sube las fotografías y el documento catastral del domicilio de recolección.</p>
            <div class="row mb-3">
                <div class="col-md-4 mb-3">
                    <div class="archivo-slot" onclick="document.getElementById('dirFotoFachada').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 16px; text-align: center; background: #FFFAF5; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                        <div id="slotFotoFachada"><div style="font-size: 28px; color: #C4A574; margin-bottom: 6px;"><i class="fas fa-image"></i></div><div style="font-weight: 700; font-size: 12px; color: #5C3819;">Foto 1 - Fachada</div><div style="font-size: 10px; color: #999; margin-top: 4px;">Haz clic para subir</div></div>
                        <img id="previewFotoFachada" src="#" alt="Vista previa" style="display:none; max-width:100%; max-height:120px; border-radius:8px; object-fit:cover;" />
                        <input type="file" class="form-control form-control-sm" id="dirFotoFachada" accept="image/*" style="display:none;" onchange="previewArchivoDir(this, 'previewFotoFachada', 'slotFotoFachada')">
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="archivo-slot" onclick="document.getElementById('dirFotoAcceso').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 16px; text-align: center; background: #FFFAF5; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                        <div id="slotFotoAcceso"><div style="font-size: 28px; color: #C4A574; margin-bottom: 6px;"><i class="fas fa-image"></i></div><div style="font-weight: 700; font-size: 12px; color: #5C3819;">Foto 2 - Acceso</div><div style="font-size: 10px; color: #999; margin-top: 4px;">Haz clic para subir</div></div>
                        <img id="previewFotoAcceso" src="#" alt="Vista previa" style="display:none; max-width:100%; max-height:120px; border-radius:8px; object-fit:cover;" />
                        <input type="file" class="form-control form-control-sm" id="dirFotoAcceso" accept="image/*" style="display:none;" onchange="previewArchivoDir(this, 'previewFotoAcceso', 'slotFotoAcceso')">
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="archivo-slot" onclick="document.getElementById('dirFotoReferencia').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 16px; text-align: center; background: #FFFAF5; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; position: relative;">
                        <div id="slotFotoReferencia"><div style="font-size: 28px; color: #C4A574; margin-bottom: 6px;"><i class="fas fa-image"></i></div><div style="font-weight: 700; font-size: 12px; color: #5C3819;">Foto 3 - Referencia</div><div style="font-size: 10px; color: #999; margin-top: 4px;">Haz clic para subir</div></div>
                        <img id="previewFotoReferencia" src="#" alt="Vista previa" style="display:none; max-width:100%; max-height:120px; border-radius:8px; object-fit:cover;" />
                        <input type="file" class="form-control form-control-sm" id="dirFotoReferencia" accept="image/*" style="display:none;" onchange="previewArchivoDir(this, 'previewFotoReferencia', 'slotFotoReferencia')">
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 mb-2">
                    <div class="archivo-slot" onclick="document.getElementById('dirDocumentoCatastral').click()" style="border: 2px dashed #C4A574; border-radius: 12px; padding: 20px; text-align: center; background: #FFFAF5; cursor: pointer; position: relative;">
                        <div id="slotDocumentoCatastral"><div style="font-size: 28px; color: #C4A574; margin-bottom: 6px;"><i class="fas fa-file-pdf"></i></div><div style="font-weight: 700; font-size: 13px; color: #5C3819;">Carta Catastral</div><div style="font-size: 11px; color: #999; margin-top: 4px;">PDF, JPG o PNG. Haz clic para subir.</div></div>
                        <div id="previewDocumentoCatastral" style="display:none; font-size:13px; color:#5C3819; font-weight:600;"><i class="fas fa-check-circle" style="color:#27AE60; margin-right:6px;"></i><span id="nombreDocumentoCatastral"></span></div>
                        <input type="file" class="form-control form-control-sm" id="dirDocumentoCatastral" accept=".pdf,image/*" style="display:none;" onchange="previewDocumentoDir(this, 'previewDocumentoCatastral', 'slotDocumentoCatastral', 'nombreDocumentoCatastral')">
                    </div>
                </div>
            </div>
        </div>
        <div class="contrato-footer">
            <div class="grupo-botones">
                <button type="button" class="btn btn-outline-secondary" onclick="cerrarModalDireccion()">Cancelar</button>
            </div>
            <div class="grupo-botones">
                <button type="button" class="btn-enviar" onclick="guardarDireccionProspecto()">
                    <i class="fas fa-save"></i> Guardar dirección y archivos
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let contratos = [];
        let contratoActual = null;
        let datosActual = null;
        let prospectoActual = null;
        let sucursalesActual = [];
        let serviciosActual = [];

        const SANA_DATA = {
            empresa: 'SANEAMIENTO SANA',
            rfc: 'SANA010101XYZ',
            nombreComercial: 'SANEAMIENTO SANA',
            telefono: '999 000 0000',
            domicilio: 'CARRETERA MERIDA - CHALMUCH KM. 1.3',
            representante: '',
            correo: 'atencion@saneamientosana.com',
            contacto: '',
            extension: '',
            datosPoder: ''
        };

        const formatMXN = (num) => {
            return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(num || 0);
        };

        $(document).ready(function() {
            cargarContratos();
            $('#txtBuscar').on('input', renderizarTabla);
            $('#cbxEstatus').on('change', renderizarTabla);
        });

        function cargarContratos() {
            fetch('@Url.Action("GetContratosPorFirmar", "Contratos")', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        contratos = res.data || [];
                        renderizarTabla();
                    } else {
                        $('#tbContratos').html(`<tr><td colspan="7" class="text-center text-danger py-4">${res.error || 'Error al cargar'}</td></tr>`);
                    }
                })
                .catch(e => {
                    console.error(e);
                    $('#tbContratos').html('<tr><td colspan="7" class="text-center text-danger py-4">Error al cargar datos</td></tr>');
                });
        }

        function renderizarTabla() {
            const filtro = $('#txtBuscar').val().toLowerCase();
            const estatusSel = $('#cbxEstatus').val();

            const filtrados = contratos.filter(c => {
                const texto = `${c.RazonSocial || ''} ${c.RFC || ''} ${c.Folio || ''}`.toLowerCase();
                const matchText = !filtro || texto.includes(filtro);
                const matchEstatus = !estatusSel || (c.Estatus || '').toLowerCase() === estatusSel.toLowerCase();
                return matchText && matchEstatus;
            });

            $('#lblCount').text(`${filtrados.length} registros encontrados`);

            if (filtrados.length === 0) {
                $('#tbContratos').html('<tr><td colspan="7" class="text-center py-4">No hay contratos por firmar.</td></tr>');
                return;
            }

            let html = '';
            filtrados.forEach(c => {
                const fecha = c.Fecha_Autorizacion ? new Date(c.Fecha_Autorizacion).toLocaleDateString('es-MX') : '—';
                const estatus = c.Estatus || 'Activo';
                const eLower = estatus.toLowerCase();
                const badge = eLower === 'por autorizar' ? { bg: '#FFF3E0', color: '#E65100', texto: 'Por Autorizar' }
                    : eLower === 'activo' ? { bg: '#FFF3E0', color: '#E65100', texto: 'Por firmar' }
                    : eLower === 'enviado' ? { bg: '#E3F2FD', color: '#1565C0', texto: 'Enviado' }
                    : eLower === 'firmado' ? { bg: '#E8F5E9', color: '#2E7D32', texto: 'Firmado' }
                    : eLower === 'rechazado' ? { bg: '#FFEBEE', color: '#C62828', texto: 'Rechazado' }
                    : { bg: '#EEEEEE', color: '#616161', texto: estatus };

                const esEditable = eLower === 'rechazado' || eLower === 'por autorizar';
                const motivoRechazo = eLower === 'rechazado' && c.Motivo_Rechazo ? `<div style="font-size:10px;color:#C62828;margin-top:2px;">${c.Motivo_Rechazo}</div>` : '';
                const btnEditar = esEditable ? `<button class="btn btn-sm" style="background: transparent; border: none; color: ${eLower === 'rechazado' ? '#C62828' : '#E65100'};" onclick="editarServicios(${c.Contrato_ID})" title="Editar servicios"><i class="fas fa-edit"></i></button>` : '';

                html += `
                    <tr>
                        <td style="font-weight: 600;">${c.Folio || '—'}</td>
                        <td>${fecha}</td>
                        <td>${c.RazonSocial || '—'}${motivoRechazo}</td>
                        <td class="text-muted">${c.RFC || '—'}</td>
                        <td class="text-muted">${formatMXN(c.Monto_Mensual)}</td>
                        <td><span class="badge" style="background: ${badge.bg}; color: ${badge.color}; padding: 4px 10px; border-radius: 12px; font-size: 11px;">${badge.texto}</span></td>
                        <td style="text-align: right;">
                            <button class="btn btn-sm" style="background: transparent; border: none; color: #5D4037;" onclick="verContrato(${c.Contrato_ID})" title="Ver contrato">
                                <i class="fas fa-eye"></i>
                            </button>
                            ${btnEditar}
                        </td>
                    </tr>
                `;
            });
            $('#tbContratos').html(html);
        }

        function verContrato(id) {
            contratoActual = contratos.find(c => c.Contrato_ID === id);
            if (!contratoActual) return;

            fetch('@Url.Action("GetDetalle", "Contratos")/' + id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        prospectoActual = res.prospecto || {};
                        sucursalesActual = res.sucursales || [];
                        serviciosActual = res.servicios || [];
                        mostrarContrato();
                        $('#modalContrato').addClass('show');
                    } else {
                        Swal.fire('Error', res.error, 'error');
                    }
                })
                .catch(console.error);
        }

        function getProp(obj, key1, key2, key3) {
            if (!obj) return '';
            if (obj[key1] !== undefined && obj[key1] !== null) return obj[key1];
            if (key2 && obj[key2] !== undefined && obj[key2] !== null) return obj[key2];
            if (key3 && obj[key3] !== undefined && obj[key3] !== null) return obj[key3];
            return '';
        }

        function mostrarContrato() {
            const c = contratoActual;
            const p = prospectoActual || {};

            $('#modalTitulo').text('CONTRATO ' + (c.Folio || ''));
            $('#detFolio').val(c.Folio || '—');
            $('#detFecha').val(c.Fecha_Autorizacion ? new Date(c.Fecha_Autorizacion).toLocaleDateString('es-MX') : '—');
            $('#detEstatus').val(c.Estatus || 'Activo');

            const estatusLower = (c.Estatus || '').toLowerCase();
            if (estatusLower === 'rechazado') {
                $('#alertaRechazo').show();
                $('#txtMotivoRechazo').text(c.Motivo_Rechazo || 'Sin motivo especificado');
                $('#txtUsuarioRechazo').text(c.Usuario_Rechaza || 'supervisor');
                $('#txtFechaRechazo').text(c.Fecha_Rechazo ? new Date(c.Fecha_Rechazo).toLocaleDateString('es-MX') : '—');
            } else {
                $('#alertaRechazo').hide();
            }

            if (estatusLower === 'activo') {
                $('#btnEnviarContrato').show();
                $('#btnEnviarRevision').hide();
            } else {
                $('#btnEnviarContrato').hide();
                $('#btnEnviarRevision').show();
            }

            $('#detRazonSocial').val(getProp(p, 'nombre', 'RazonSocial') || c.RazonSocial || '—');
            $('#detRFC').val(getProp(p, 'rfc', 'RFC') || c.RFC || '—');
            $('#detNombreComercial').val(getProp(p, 'nombreComercial', 'Nombre_Comercial') || c.Nombre_Comercial || c.RazonSocial || '—');
            $('#detRepresentante').val(getProp(p, 'contacto', 'Nombre_Prospecto') || c.Contacto || '—');

            const domFiscal = getProp(p, 'domicilioFiscal', 'Domicilio_Fiscal')
                || [getProp(p, 'calle', 'Calle'), getProp(p, 'numExt', 'Num_Ext'), getProp(p, 'colonia', 'Colonia'), getProp(p, 'municipio', 'Municipio')].filter(Boolean).join(', ')
                || '—';
            const domRecoleccion = getProp(p, 'domicilioRecoleccion', 'Domicilio_Recoleccion') || domFiscal;
            $('#detDomicilioFiscal').val(domFiscal);
            $('#detDomicilioRecoleccion').val(domRecoleccion);

            $('#detTelefono').val(getProp(p, 'telefono', 'Telefono') || c.Telefono || '—');
            $('#detCorreo').val(getProp(p, 'email', 'Correo') || c.Correo || '—');
            $('#detFolioCatastral').val(getProp(p, 'folioCatastral', 'Folio_Catastral') || c.Folio_Catastral || '—');
            $('#detCorreoAtencion').val(SANA_DATA.correo);

            renderizarServicios();
        }

        function renderizarServicios() {
            const p = prospectoActual || {};
            const nombreCliente = getProp(p, 'nombreComercial', 'Nombre_Comercial') || getProp(p, 'nombre', 'Nombre') || 'Cliente';

            const grupos = [
                { id: 'MATRIZ', nombre: `MATRIZ - ${nombreCliente}` },
                ...sucursalesActual.map((s, idx) => ({
                    id: getProp(s, 'id', 'Sucursal_ID'),
                    nombre: `SUCURSAL ${String(idx + 1).padStart(3, '0')} - ${getProp(s, 'nombre_sucursal', 'Nombre_Sucursal')}`
                }))
            ];

            const serviciosDeGrupo = (g) => serviciosActual.filter(s => {
                const sid = String(s.sucursal_id || '');
                if (g.id === 'MATRIZ') {
                    return !sid || sid === 'MATRIZ' || sid === 'null' || sid === '';
                }
                return sid === String(g.id);
            });

            let html = '';
            let subtotalGlobal = 0;
            let descuentoGlobal = 0;
            let domiciliosActivos = 0;

            grupos.forEach(g => {
                const items = serviciosDeGrupo(g).map(normalizarServicio);
                if (items.length === 0) return;

                domiciliosActivos++;
                const subtotalGrupo = items.reduce((sum, it) => sum + it.subtotal, 0);
                subtotalGlobal += subtotalGrupo;

                items.forEach(it => {
                    const desc = (Number(it.porcentaje_descuento || 0) / 100);
                    if (desc > 0 && desc < 1) {
                        descuentoGlobal += (it.subtotal / (1 - desc)) - it.subtotal;
                    }
                });

                html += `
                    <div style="margin-bottom: 8px; display: flex; justify-content: space-between; font-weight: bold; font-size: 14px;">
                        <span>${g.nombre.toUpperCase()}</span>
                        <span>${formatMXN(subtotalGrupo)} / mes</span>
                    </div>
                    <table class="servicios-tabla">
                        <thead>
                            <tr>
                                <th>TIPO</th>
                                <th>SERVICIO</th>
                                <th>DETALLES</th>
                                <th style="text-align: center;">DÍAS</th>
                                <th style="text-align: center;">PRECIO UNIT.</th>
                                <th style="text-align: center;">% ADIC.</th>
                                <th style="text-align: center;">% DESC.</th>
                                <th style="text-align: center;">SUBTOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map(it => `
                                <tr>
                                    <td><span class="badge-tipo" style="background: ${it.tipo_servicio === 'RSU' ? '#F57F17' : '#4CAF50'};">${it.tipo_servicio}</span></td>
                                    <td style="font-weight: 600;">${it.tipo_servicio === 'RSU' ? 'Residuos Sólidos Urbanos' : 'Residuos de Manejo Especial'}</td>
                                    <td>${renderDetalleServicio(it)}</td>
                                    <td style="text-align: center;">
                                        <div style="display: flex; gap: 2px; justify-content: center;">
                                            ${it.dias_asignados.map(d => `<span class="badge-dia" style="background: ${it.tipo_servicio === 'RSU' ? '#FFECB3' : '#C8E6C9'}; color: ${it.tipo_servicio === 'RSU' ? '#F57F17' : '#2E7D32'};">${d.substring(0, 3)}</span>`).join(' ')}
                                        </div>
                                    </td>
                                    <td style="text-align: center; font-weight: 600;">${formatMXN(it.precio_unitario_calculado)}</td>
                                    <td style="text-align: center;">${it.porcentaje_adicional || 0}%</td>
                                    <td style="text-align: center;">${it.porcentaje_descuento || 0}%</td>
                                    <td style="text-align: center; font-weight: bold; color: #2E7D32;">${formatMXN(it.subtotal)}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                `;
            });

            if (html === '') {
                html = '<p class="text-muted">Sin servicios cotizados para mostrar.</p>';
            }

            const ivaGlobal = subtotalGlobal * 0.16;
            const totalGlobal = subtotalGlobal + ivaGlobal;

            html += `
                <div class="summary-box">
                    <div class="summary-row"><span>SUBTOTAL SERVICIOS (${domiciliosActivos} DOMICILIOS)</span><span style="font-weight: bold;">${formatMXN(subtotalGlobal + descuentoGlobal)}</span></div>
                    <div class="summary-row"><span>DESCUENTO</span><span style="font-weight: bold; color: #C62828;">-${formatMXN(descuentoGlobal)}</span></div>
                    <div class="summary-row"><span>IVA</span><span style="font-weight: bold;">${formatMXN(ivaGlobal)}</span></div>
                    <div class="summary-total"><span>TOTAL MENSUAL ESTIMADO</span><span>${formatMXN(totalGlobal)}</span></div>
                </div>
            `;

            $('#serviciosContainer').html(html);

            const primerServicio = serviciosActual[0];
            if (primerServicio) {
                const it = normalizarServicio(primerServicio);
                $('#condPrecioAdicional').text(`${formatMXN(it.precio_unitario_calculado)} pesos más I.V.A.`);
            }
        }

        function normalizarServicio(s) {
            const diasAsignados = Array.isArray(s.dias_asignados)
                ? s.dias_asignados
                : (s.dias_asignados || '').toString().split(',').filter(Boolean);

            const rawTipo = (s.tipo_residuo || s.tipo_servicio || '').toString().toUpperCase();
            const isRsu = !rawTipo.includes('ESPECIAL') && (rawTipo.includes('RSU') || rawTipo.includes('URBANO') || rawTipo.includes('SÓLIDO') || rawTipo.includes('SOLIDO') || ((Number(s.costo_tonelada) || 0) === 0 && (Number(s.costo_disposicion) || 0) === 0));
            const tipo = isRsu ? 'RSU' : 'RME';

            const bolsas = isRsu ? Number(s.volumen_estimado || s.bolsas || 0) : 0;
            const recolectores = !isRsu ? Number(s.recolectores || s.volumen_estimado || 0) : 0;

            const costoTonelada = Number(s.costo_tonelada || 0);
            const costoDisposicion = Number(s.costo_disposicion || 0);
            const precioUnitarioDb = Number(s.precio_unitario || 0);

            const precioUnitario = isRsu
                ? (precioUnitarioDb || 18.60)
                : ((costoTonelada + costoDisposicion) || precioUnitarioDb);

            const diasPorSemana = diasAsignados.length || 1;
            const porcentaje = Number(s.porcentaje_adicional || 0) / 100;
            const descuento = Number(s.porcentaje_descuento || 0) / 100;

            let subtotal = 0;
            if (isRsu) {
                const bolsasMensuales = (bolsas * diasPorSemana * 52) / 12;
                subtotal = bolsasMensuales * precioUnitario * (1 + porcentaje) * (1 - descuento);
            } else {
                const viajesMensuales = recolectores * diasPorSemana * 4;
                subtotal = precioUnitario * viajesMensuales * (1 + porcentaje) * (1 - descuento);
            }

            return {
                ...s,
                tipo_servicio: tipo,
                dias_asignados: diasAsignados,
                bolsas,
                recolectores,
                precio_unitario_calculado: precioUnitario,
                subtotal
            };
        }

        function renderDetalleServicio(it) {
            if (it.tipo_servicio === 'RSU') {
                return `
                    <div style="display: grid; grid-template-columns: 70px 1fr; gap: 2px 6px;">
                        <span style="color: #555;">Producto:</span><span style="font-weight: 600;">${it.tipo_residuo || '—'}</span>
                        <span style="color: #555;">Ruta:</span><span style="color: #1565C0;">${it.ruta || 'Por asignar'}</span>
                        <span style="color: #555;">Bolsas:</span><span style="font-weight: 600;">${it.bolsas}</span>
                    </div>`;
            }
            return `
                <div style="display: grid; grid-template-columns: 80px 1fr; gap: 2px 6px;">
                    <span style="color: #555;">Unidad:</span><span style="color: #1565C0;">${it.tipo_unidad || 'Camión 3.5 Ton'}</span>
                    <span style="color: #555;">Tipo Serv:</span><span style="color: #8E24AA; font-weight: 600;">${it.tipo_cobro === 'PESO' ? 'Peso' : 'Viaje'}</span>
                    <span style="color: #555;">Recorrido:</span><span style="color: #616161;">Config</span>
                    <span style="color: #555;">Recolecciones:</span><span style="font-weight: 600;">${it.recolectores}/día</span>
                    <span style="color: #555;">Turno:</span><span style="color: #F57F17; font-weight: 600; text-transform: capitalize;">${it.turno ? it.turno.toLowerCase() : 'Por asignar'}</span>
                </div>`;
        }

        function cerrarModal() {
            $('#modalContrato').removeClass('show');
        }

        // ─────────────────────────────────────────────────────────
        // EDICIÓN DE SERVICIOS COTIZADOS (solo contratos rechazados)
        // ─────────────────────────────────────────────────────────
        let serviciosEditando = [];
        let contratoEditandoId = null;

        let catalogosEditar = { serviciosResiduos: [], unidadesRme: [] };

        function editarServicios(id) {
            contratoEditandoId = id;
            const c = contratos.find(x => x.Contrato_ID === id);
            if (!c) return;

            fetch('@Url.Action("GetDetalle", "Contratos")/' + id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        prospectoActual = res.prospecto || {};
                        sucursalesActual = res.sucursales || [];
                        serviciosEditando = JSON.parse(JSON.stringify(res.servicios || []));
                        catalogosEditar = res.catalogos || { serviciosResiduos: [], unidadesRme: [] };
                        llenarCamposClienteEdicion();
                        mostrarEdicionServicios();
                        $('#modalEditarServicios').addClass('show');
                    } else {
                        Swal.fire('Error', res.error, 'error');
                    }
                })
                .catch(console.error);
        }

        function parsearDireccion(texto) {
            const limpio = (texto || '').replace(/^C\.P\.\s*/i, '').trim();
            const partes = limpio.split(',').map(x => x.trim()).filter(Boolean);
            const dir = { calle: '', numExt: '', numInt: '', colonia: '', municipio: '', cp: '', estado: '' };
            if (partes.length === 0) return dir;
            dir.calle = partes[0] || '';
            let i = 1;
            if (partes[i] && partes[i].startsWith('#')) { dir.numExt = partes[i].replace('#', '').trim(); i++; }
            else if (partes[i] && /^\d+[A-Z]?$/i.test(partes[i])) { dir.numExt = partes[i]; i++; }
            if (partes[i] && partes[i].toUpperCase().startsWith('INT. ')) { dir.numInt = partes[i].replace(/int\.\s*/i, '').trim(); i++; }
            if (partes[i]) { dir.colonia = partes[i]; i++; }
            if (partes[i]) { dir.municipio = partes[i]; i++; }
            if (partes[i] && partes[i].toUpperCase().startsWith('C.P.')) { dir.cp = partes[i].replace(/c\.p\.\s*/i, '').trim(); i++; }
            if (partes[i]) { dir.estado = partes[i]; }
            return dir;
        }

        function formatearDireccion(calle, numExt, numInt, colonia, municipio, cp, estado) {
            const partes = [];
            if (calle) partes.push(calle.trim());
            if (numExt) partes.push('#' + numExt.trim());
            if (numInt) partes.push('Int. ' + numInt.trim());
            if (colonia) partes.push(colonia.trim());
            if (municipio) partes.push(municipio.trim());
            if (cp) partes.push('C.P. ' + cp.trim());
            if (estado) partes.push(estado.trim());
            return partes.join(', ');
        }

        function llenarCamposClienteEdicion() {
            const p = prospectoActual || {};
            const c = contratoActual || contratos.find(x => x.Contrato_ID === contratoEditandoId) || {};
            $('#editRazonSocial').val(getProp(p, 'nombre', 'RazonSocial') || c.RazonSocial || '');
            $('#editRFC').val(getProp(p, 'rfc', 'RFC') || c.RFC || '');
            $('#editNombreComercial').val(getProp(p, 'nombreComercial', 'Nombre_Comercial') || c.Nombre_Comercial || c.RazonSocial || '');
            $('#editRepresentante').val(getProp(p, 'contacto', 'Nombre_Prospecto') || c.Contacto || '');

            const domFiscal = getProp(p, 'domicilioFiscal', 'Domicilio_Fiscal')
                || [getProp(p, 'calle', 'Calle'), getProp(p, 'numExt', 'Num_Ext'), getProp(p, 'colonia', 'Colonia'), getProp(p, 'municipio', 'Municipio')].filter(Boolean).join(', ')
                || '';
            $('#editDomicilioFiscal').val(domFiscal);
            $('#editDomicilioRecoleccion').val(getProp(p, 'domicilioRecoleccion', 'Domicilio_Recoleccion') || domFiscal);
            $('#editTelefono').val(getProp(p, 'telefono', 'Telefono') || c.Telefono || '');
            $('#editCorreo').val(getProp(p, 'email', 'Correo') || c.Correo || '');
            $('#editFolioCatastral').val(getProp(p, 'folioCatastral', 'Folio_Catastral') || c.Folio_Catastral || '');
        }

        function abrirModalDireccion() {
            const fiscal = parsearDireccion($('#editDomicilioFiscal').val());
            const rec = parsearDireccion($('#editDomicilioRecoleccion').val());
            $('#dirFiscalCalle').val(fiscal.calle);
            $('#dirFiscalNumExt').val(fiscal.numExt);
            $('#dirFiscalNumInt').val(fiscal.numInt);
            $('#dirFiscalColonia').val(fiscal.colonia);
            $('#dirFiscalMunicipio').val(fiscal.municipio);
            $('#dirFiscalCP').val(fiscal.cp);
            $('#dirFiscalEstado').val(fiscal.estado);
            $('#dirRecoleccionCalle').val(rec.calle);
            $('#dirRecoleccionNumExt').val(rec.numExt);
            $('#dirRecoleccionNumInt').val(rec.numInt);
            $('#dirRecoleccionColonia').val(rec.colonia);
