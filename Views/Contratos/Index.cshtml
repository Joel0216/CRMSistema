        function previewArchivoDir(input, imgId, placeholderId) {
            const file = input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById(imgId).src = e.target.result;
                document.getElementById(imgId).style.display = 'block';
                document.getElementById(placeholderId).style.display = 'none';
            };
            reader.readAsDataURL(file);
        }

        function previewDocumentoDir(input, previewId, placeholderId, nombreId) {
            const file = input.files[0];
            if (!file) return;
            document.getElementById(nombreId).textContent = file.name;
            document.getElementById(previewId).style.display = 'block';
            document.getElementById(placeholderId).style.display = 'none';
        }

        function guardarDireccionProspecto() {
            if (!contratoEditandoId) return;

            // El domicilio fiscal es solo lectura: se conserva el valor actual del contrato.
            const domFiscal = $('#editDomicilioFiscal').val() || '';

            const domRecoleccion = formatearDireccion(
                $('#dirRecoleccionCalle').val(), $('#dirRecoleccionNumExt').val(), $('#dirRecoleccionNumInt').val(),
                $('#dirRecoleccionColonia').val(), $('#dirRecoleccionMunicipio').val(), $('#dirRecoleccionCP').val(), $('#dirRecoleccionEstado').val());

            const folio = $('#dirFolioCatastral').val() || '';

            const formData = new FormData();
            formData.append('contrato_id', contratoEditandoId);
            formData.append('fiscal_calle', $('#dirFiscalCalle').val());
            formData.append('fiscal_num_ext', $('#dirFiscalNumExt').val());
            formData.append('fiscal_num_int', $('#dirFiscalNumInt').val());
            formData.append('fiscal_colonia', $('#dirFiscalColonia').val());
            formData.append('fiscal_municipio', $('#dirFiscalMunicipio').val());
            formData.append('fiscal_cp', $('#dirFiscalCP').val());
            formData.append('fiscal_estado', $('#dirFiscalEstado').val());
            formData.append('recoleccion_calle', $('#dirRecoleccionCalle').val());
            formData.append('recoleccion_num_ext', $('#dirRecoleccionNumExt').val());
            formData.append('recoleccion_num_int', $('#dirRecoleccionNumInt').val());
            formData.append('recoleccion_colonia', $('#dirRecoleccionColonia').val());
            formData.append('recoleccion_municipio', $('#dirRecoleccionMunicipio').val());
            formData.append('recoleccion_cp', $('#dirRecoleccionCP').val());
            formData.append('recoleccion_estado', $('#dirRecoleccionEstado').val());
            formData.append('folio_catastral', folio);

            const agregarArchivo = (id, nombre) => {
                const input = document.getElementById(id);
                if (input && input.files.length > 0) formData.append(nombre, input.files[0]);
            };
            agregarArchivo('dirFotoFachada', 'foto_fachada');
            agregarArchivo('dirFotoAcceso', 'foto_acceso');
            agregarArchivo('dirFotoReferencia', 'foto_referencia');
            agregarArchivo('dirDocumentoCatastral', 'documento_catastral');

            fetch('@Url.Action("GuardarDireccionProspecto", "Contratos")', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    $('#editDomicilioFiscal').val(domFiscal);
                    $('#editDomicilioRecoleccion').val(domRecoleccion);
                    $('#editFolioCatastral').val(folio);
                    cerrarModalDireccion();
                    Swal.fire('Guardado', res.message, 'success');
                } else {
                    Swal.fire('Error', res.error || 'No se pudo guardar', 'error');
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire('Error', 'Error de red al guardar dirección.', 'error');
            });
        }

        function mostrarEdicionServicios() {
            const grupos = [
                { id: 'MATRIZ', nombre: 'MATRIZ' },
                ...sucursalesActual.map((s, idx) => ({
                    id: String(getProp(s, 'id', 'Sucursal_ID')),
                    nombre: `SUCURSAL ${String(idx + 1).padStart(3, '0')} - ${getProp(s, 'nombre_sucursal', 'Nombre_Sucursal')}`
                }))
            ];

            const serviciosDeGrupo = (g) => serviciosEditando.filter(s => {
                const sid = String(s.sucursal_id || '');
                if (g.id === 'MATRIZ') return !sid || sid === 'MATRIZ' || sid === 'null' || sid === '';
                return sid === g.id;
            });

            let html = '';
            grupos.forEach(g => {
                const items = serviciosDeGrupo(g);
                if (items.length === 0) return;

                html += `
                    <div style="margin-bottom: 8px; font-weight: bold; font-size: 14px;">${g.nombre.toUpperCase()}</div>
                    <table class="servicios-tabla">
                        <thead>
                            <tr>
                                <th>TIPO</th>
                                <th>SERVICIO / UNIDAD</th>
                                <th style="text-align: center;">DÍAS / COBRO / TURNO</th>
                                <th style="text-align: center;">CANT.</th>
                                <th style="text-align: center;">PRECIO UNIT.</th>
                                <th style="text-align: center;">% ADIC.</th>
                                <th style="text-align: center;">% DESC.</th>
                                <th style="text-align: center;">SUBTOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map((it, idxGlobal) => {
                                const idx = serviciosEditando.indexOf(it);
                                const tipoInfo = determinarTipoServicio(it);
                                const isRSU = tipoInfo.isRSU;
                                const dias = Array.isArray(it.dias_asignados) ? it.dias_asignados : (it.dias_asignados || '').toString().split(',').filter(Boolean);
                                const diasOpciones = ['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'].map(d => {
                                    const checked = dias.includes(d) ? 'checked' : '';
                                    return `<label style="display:inline-flex;align-items:center;gap:2px;font-size:10px;margin-right:4px;"><input type="checkbox" ${checked} onchange="toggleDiaEdicion(${idx}, '${d}', this.checked)" style="width:auto;"> ${d.substring(0,3)}</label>`;
                                }).join('');
                                const cantidad = isRSU ? (it.volumen_estimado || 0) : (it.recolectores || 0);
                                const pu = tipoInfo.precioUnitario;
                                const subtotal = calcularSubtotalEdicion(it);
                                const adic = it.porcentaje_adicional || 0;
                                const desc = it.porcentaje_descuento || 0;

                                let campoServicio = '';
                                let campoCobroTurno = '';

                                if (isRSU) {
                                    const opciones = (catalogosEditar.serviciosResiduos || []).map(s => {
                                        const selected = (s.descripcion || '').toUpperCase() === (it.tipo_residuo || '').toUpperCase() ? 'selected' : '';
                                        return `<option value="${s.descripcion}" ${selected}>${s.descripcion}</option>`;
                                    }).join('');
                                    campoServicio = `
                                        <label style="font-size:9px;color:#666;">TIPO DE RESIDUO</label>
                                        <select class="form-select form-select-sm" onchange="actualizarServicioEdicion(${idx}, 'tipo_residuo', this.value)" style="min-width:140px;"><option value="">-- Selecciona --</option>${opciones}</select>`;
                                } else {
                                    const opcionesUnidad = (catalogosEditar.unidadesRme || []).map(u => {
                                        const selected = (u.Nombre_Unidad || '') === (it.tipo_unidad || '') ? 'selected' : '';
                                        return `<option value="${u.Nombre_Unidad}" ${selected}>${u.Nombre_Unidad} - ${formatMXN(u.Costo_Unitario)}</option>`;
                                    }).join('');
                                    campoServicio = `
                                        <label style="font-size:9px;color:#666;">TIPO DE UNIDAD</label>
                                        <select class="form-select form-select-sm" onchange="cambiarUnidadRme(${idx}, this.value)" style="min-width:140px;"><option value="">-- Selecciona --</option>${opcionesUnidad}</select>`;
                                    campoCobroTurno = `
                                        <div style="display:flex;gap:4px;justify-content:center;">
                                            <select class="form-select form-select-sm" onchange="actualizarServicioEdicion(${idx}, 'tipo_cobro', this.value)" style="min-width:90px;">
                                                <option value="VIAJE" ${(it.tipo_cobro || 'VIAJE') === 'VIAJE' ? 'selected' : ''}>VIAJE</option>
                                                <option value="PESO" ${(it.tipo_cobro || '') === 'PESO' ? 'selected' : ''}>PESO</option>
                                            </select>
                                            <select class="form-select form-select-sm" onchange="actualizarServicioEdicion(${idx}, 'turno', this.value)" style="min-width:90px;">
                                                ${['MAÑANA','TARDE','NOCHE'].map(t => `<option value="${t}" ${(it.turno || '').toUpperCase() === t ? 'selected' : ''}>${t}</option>`).join('')}
                                            </select>
                                        </div>`;
                                }

                                return `
                                    <tr>
                                        <td><span class="badge-tipo" style="background: ${isRSU ? '#F57F17' : '#4CAF50'};">${isRSU ? 'RSU' : 'RME'}</span></td>
                                        <td style="font-weight: 600;">${campoServicio}</td>
                                        <td style="text-align: center;">
                                            <div style="display:flex;flex-wrap:wrap;justify-content:center;">${diasOpciones}</div>
                                            ${!isRSU ? campoCobroTurno : ''}
                                        </td>
                                        <td style="text-align: center;"><input type="number" class="form-control form-control-sm" value="${cantidad}" onchange="actualizarServicioEdicion(${idx}, '${isRSU ? 'volumen_estimado' : 'recolectores'}', this.value)" style="width:70px;display:inline;" min="1" step="1"></td>
                                        <td style="text-align: center; font-weight: 600;">${formatMXN(pu)}</td>
                                        <td style="text-align: center;"><input type="number" class="form-control form-control-sm" value="${adic}" onchange="actualizarServicioEdicion(${idx}, 'porcentaje_adicional', this.value)" style="width:60px;display:inline;" min="0" step="0.01"> %</td>
                                        <td style="text-align: center;"><input type="number" class="form-control form-control-sm" value="${desc}" onchange="actualizarServicioEdicion(${idx}, 'porcentaje_descuento', this.value)" style="width:60px;display:inline;" min="0" max="100" step="0.01"> %</td>
                                        <td style="text-align: center; font-weight: bold; color: #2E7D32;">${formatMXN(subtotal)}</td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
            });

            if (html === '') {
                html = '<p class="text-muted">Sin servicios cotizados para editar.</p>';
            }

            $('#editarServiciosContainer').html(html);
            renderTotalesEdicion();
        }

        function determinarTipoServicio(s) {
            const rawTipo = (s.tipo_residuo || s.tipo_servicio || '').toString().toUpperCase();
            const isRSU = !rawTipo.includes('ESPECIAL') && (rawTipo.includes('RSU') || rawTipo.includes('URBANO') || rawTipo.includes('SÓLIDO') || rawTipo.includes('SOLIDO') || ((Number(s.costo_tonelada) || 0) === 0 && (Number(s.costo_disposicion) || 0) === 0));
            const costoT = Number(s.costo_tonelada || 0);
            const costoD = Number(s.costo_disposicion || 0);
            const precioUnitario = isRSU
                ? (Number(s.precio_unitario) || 18.60)
                : (costoT + costoD || Number(s.precio_unitario) || 0);
            return { isRSU, precioUnitario, rawTipo };
        }

        function cambiarUnidadRme(idx, nombreUnidad) {
            const u = (catalogosEditar.unidadesRme || []).find(x => x.Nombre_Unidad === nombreUnidad);
            if (u) {
                serviciosEditando[idx].tipo_unidad = nombreUnidad;
                serviciosEditando[idx].costo_tonelada = u.Costo_Unitario || 0;
                serviciosEditando[idx].costo_disposicion = 0;
            } else {
                serviciosEditando[idx].tipo_unidad = nombreUnidad;
                serviciosEditando[idx].costo_tonelada = 0;
            }
            mostrarEdicionServicios();
        }

        function actualizarServicioEdicion(idx, campo, valor) {
            if (campo === 'tipo_residuo' || campo === 'tipo_unidad' || campo === 'tipo_cobro' || campo === 'turno' || campo === 'ruta') {
                serviciosEditando[idx][campo] = valor;
            } else {
                let v = Number(valor) || 0;
                if (campo === 'porcentaje_descuento' && v > 100) v = 100;
                serviciosEditando[idx][campo] = v;
            }
            mostrarEdicionServicios();
        }

        function toggleDiaEdicion(idx, dia, checked) {
            const it = serviciosEditando[idx];
            let dias = Array.isArray(it.dias_asignados)
                ? it.dias_asignados
                : (it.dias_asignados || '').toString().split(',').filter(Boolean);
            dias = dias.filter(d => d !== dia);
            if (checked) dias.push(dia);
            it.dias_asignados = dias.join(',');
            mostrarEdicionServicios();
        }

        function calcularSubtotalEdicion(s) {
            const tipoInfo = determinarTipoServicio(s);
            const dias = Array.isArray(s.dias_asignados)
                ? s.dias_asignados
                : (s.dias_asignados || '').toString().split(',').filter(Boolean);
            const diasPorSemana = dias.length || 1;
            const adicional = (Number(s.porcentaje_adicional) || 0) / 100;
            const descuento = (Number(s.porcentaje_descuento) || 0) / 100;
            let base = 0;

            if (tipoInfo.isRSU) {
                const bolsas = Number(s.volumen_estimado || 0);
                const bolsasMensuales = (bolsas * diasPorSemana * 52) / 12;
                base = bolsasMensuales * tipoInfo.precioUnitario;
            } else {
                const rec = Number(s.recolectores || 0);
                const viajesMensuales = rec * diasPorSemana * 4;
                base = viajesMensuales * tipoInfo.precioUnitario;
            }

            return base * (1 + adicional) * (1 - descuento);
        }

        function renderTotalesEdicion() {
            const subtotal = serviciosEditando.reduce((sum, s) => sum + calcularSubtotalEdicion(s), 0);
            const descuento = serviciosEditando.reduce((sum, s) => {
                const desc = (Number(s.porcentaje_descuento) || 0) / 100;
                if (desc <= 0 || desc >= 1) return sum;
                const sub = calcularSubtotalEdicion(s);
                return sum + (sub / (1 - desc) - sub);
            }, 0);
            const iva = subtotal * 0.16;
            const total = subtotal + iva;

            $('#editSubtotal').text(formatMXN(subtotal + descuento));
            $('#editIVA').text(formatMXN(iva));
            $('#editDescuento').text('-' + formatMXN(descuento));
            $('#editTotal').text(formatMXN(total));
        }

        function guardarServiciosEditados() {
            if (!contratoEditandoId || serviciosEditando.length === 0) return;

            const payloadServicios = serviciosEditando.map(s => ({
                id: s.id || 0,
                trato_id: s.trato_id || 0,
                tipo_residuo: s.tipo_residuo || '',
                frecuencia: s.frecuencia || 'Semanal',
                periodicidad_pago: s.periodicidad_pago || 'Mensual',
                volumen_estimado: s.volumen_estimado,
                precio_unitario: Number(s.precio_unitario) || (((Number(s.costo_tonelada) || 0) === 0 && (Number(s.costo_disposicion) || 0) === 0) ? 18.60 : ((Number(s.costo_tonelada) || 0) + (Number(s.costo_disposicion) || 0))),
                dias_asignados: Array.isArray(s.dias_asignados) ? s.dias_asignados.join(',') : (s.dias_asignados || ''),
                porcentaje_adicional: s.porcentaje_adicional || 0,
                porcentaje_descuento: s.porcentaje_descuento || 0,
                sucursal_id: s.sucursal_id,
                tipo_unidad: s.tipo_unidad,
                tipo_cobro: s.tipo_cobro,
                recolectores: s.recolectores,
                turno: s.turno,
                ruta: s.ruta || 'Por asignar',
                costo_tonelada: s.costo_tonelada,
                costo_disposicion: s.costo_disposicion
            }));

            const payload = {
                contrato_id: contratoEditandoId,
                servicios: payloadServicios,
                cliente: {
                    razon_social: $('#editRazonSocial').val(),
                    rfc: $('#editRFC').val(),
                    nombre_comercial: $('#editNombreComercial').val(),
                    representante_legal: $('#editRepresentante').val(),
                    domicilio_fiscal: $('#editDomicilioFiscal').val(),
                    domicilio_recoleccion: $('#editDomicilioRecoleccion').val(),
                    telefono: $('#editTelefono').val(),
                    correo: $('#editCorreo').val(),
                    folio_catastral: $('#editFolioCatastral').val()
                }
            };

            Swal.fire({
                title: '¿Guardar cambios?',
                text: 'El contrato volverá a estatus "Por Autorizar" para revisión del supervisor.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, guardar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#2E7D32'
            }).then((result) => {
                if (!result.isConfirmed) return;

                fetch('@Url.Action("GuardarServicios", "Contratos")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify(payload)
                }).then(r => r.json()).then(res => {
                    if (res.success) {
                        Swal.fire('Guardado', res.message, 'success').then(() => {
                            cerrarModalEditar();
                            cargarContratos();
                        });
                    } else {
                        Swal.fire('Error', res.error, 'error');
                    }
                }).catch(e => {
                    console.error(e);
                    Swal.fire('Error', 'No se pudieron guardar los cambios.', 'error');
                });
            });
        }

        function cerrarModalEditar() {
            $('#modalEditarServicios').removeClass('show');
        }

        function enviarPreContrato() {
            if (!contratoActual) return;
            Swal.fire('Enviado', 'Pre-Contrato enviado con éxito.', 'success');
        }

        function reenviarContrato() {
            if (!contratoActual) return;
            Swal.fire('Re-enviado', 'Se ha vuelto a enviar el contrato.', 'success');
        }

        function descargarPDF() {
            if (!contratoActual) return;

            const c = contratoActual;
            const p = prospectoActual || {};
            const nombreCliente = getProp(p, 'nombreComercial', 'Nombre_Comercial') || getProp(p, 'nombre', 'Nombre') || 'Cliente';
            const fechaAut = c.Fecha_Autorizacion ? new Date(c.Fecha_Autorizacion).toLocaleDateString('es-MX') : '—';
            const domicilioFiscal = getProp(p, 'domicilioFiscal', 'Domicilio_Fiscal')
                || [getProp(p, 'calle', 'Calle'), getProp(p, 'numExt', 'Num_Ext'), getProp(p, 'colonia', 'Colonia'), getProp(p, 'municipio', 'Municipio')].filter(Boolean).join(', ')
                || '—';
            const domicilioRecoleccion = getProp(p, 'domicilioRecoleccion', 'Domicilio_Recoleccion') || domicilioFiscal;
            const representante = getProp(p, 'contacto', 'Nombre_Prospecto') || c.Contacto || '—';

            // Servicios
            let serviciosHtml = '';
            let subtotalGlobal = 0;
            let descuentoGlobal = 0;
            let domiciliosActivos = 0;

            const grupos = [
                { id: 'MATRIZ', nombre: `MATRIZ - ${nombreCliente}` },
                ...sucursalesActual.map((s, idx) => ({
                    id: getProp(s, 'id', 'Sucursal_ID'),
                    nombre: `SUCURSAL ${String(idx + 1).padStart(3, '0')} - ${getProp(s, 'nombre_sucursal', 'Nombre_Sucursal')}`
                }))
            ];

            const serviciosDeGrupo = (g) => serviciosActual.filter(s => {
                const sid = String(s.sucursal_id || '');
                if (g.id === 'MATRIZ') return !sid || sid === 'MATRIZ' || sid === 'null' || sid === '';
                return sid === String(g.id);
            });

            grupos.forEach(g => {
                const items = serviciosDeGrupo(g).map(normalizarServicio);
                if (items.length === 0) return;
                domiciliosActivos++;
                const subtotalGrupo = items.reduce((sum, it) => sum + it.subtotal, 0);
                subtotalGlobal += subtotalGrupo;
                items.forEach(it => {
                    const desc = (Number(it.porcentaje_descuento || 0) / 100);
                    if (desc > 0 && desc < 1) descuentoGlobal += (it.subtotal / (1 - desc)) - it.subtotal;
                });

                const filas = items.map(it => `
                    <tr>
                        <td>${it.tipo_servicio}</td>
                        <td>${it.tipo_servicio === 'RSU' ? 'Residuos Sólidos Urbanos' : 'Residuos de Manejo Especial'}</td>
                        <td>${renderDetalleServicio(it).replace(/style="[^"]*"/g, '').replace(/<div[^>]*>/g, '').replace(/<\/div>/g, '<br>')}</td>
                        <td style="text-align:center">${it.dias_asignados.map(d => d.substring(0, 3)).join(' ')}</td>
                        <td style="text-align:right">${formatMXN(it.precio_unitario_calculado)}</td>
                        <td style="text-align:center">${it.porcentaje_adicional || 0}%</td>
                        <td style="text-align:center">${it.porcentaje_descuento || 0}%</td>
                        <td style="text-align:right">${formatMXN(it.subtotal)}</td>
                    </tr>
                `).join('');

                serviciosHtml += `
                    <h3 style="color:#D84315; font-size:11px; border-bottom:1px solid #eee; padding-bottom:4px; margin-top:12px; margin-bottom:6px;">${g.nombre.toUpperCase()}</h3>
                    <table style="width:100%; border-collapse:collapse; border:1px solid #4E342E; font-size:9px; margin-bottom:8px;">
                        <thead style="background:#8D6E63; color:white;">
                            <tr>
                                <th style="padding:3px">TIPO</th>
                                <th style="padding:3px">SERVICIO</th>
                                <th style="padding:3px">DETALLES</th>
                                <th style="padding:3px; text-align:center">DÍAS</th>
                                <th style="padding:3px; text-align:right">P.UNIT.</th>
                                <th style="padding:3px; text-align:center">%ADIC</th>
                                <th style="padding:3px; text-align:center">%DESC</th>
                                <th style="padding:3px; text-align:right">SUBTOTAL</th>
                            </tr>
                        </thead>
                        <tbody>${filas}</tbody>
                    </table>
                `;
            });

            const ivaGlobal = subtotalGlobal * 0.16;
            const totalGlobal = subtotalGlobal + ivaGlobal;

            const html = `
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Contrato ${c.Folio || ''}</title>
    <style>
        @@page { size: letter; margin: 12mm; }
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; padding: 10px; color: #333; font-size: 10px; line-height: 1.3; }
        h1 { font-size: 14px; color: #3E2723; margin: 0 0 2px 0; }
        h2 { font-size: 10px; color: #D84315; border-bottom: 1px solid #eee; padding-bottom: 3px; margin: 10px 0 6px 0; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .campo { margin-bottom: 4px; }
        .campo label { display: block; font-size: 7px; font-weight: 700; color: #666; text-transform: uppercase; margin-bottom: 1px; }
        .campo span { display: block; padding: 1px 0; font-weight: 600; font-size: 9px; }
        .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
        .summary { width: 260px; margin-left: auto; border: 1px solid #C4A574; border-radius: 6px; padding: 8px; background: #FFFDE7; margin-top: 8px; }
        .summary-row { display: flex; justify-content: space-between; margin-bottom: 3px; font-size: 9px; }
        .summary-total { display: flex; justify-content: space-between; background: #3E2723; color: white; padding: 6px; font-weight: bold; border-radius: 0 0 4px 4px; margin: 8px -8px -8px -8px; font-size: 10px; }
        table th, table td { padding: 3px; border: 1px solid #4E342E; }
        .condiciones { font-size: 8px; line-height: 1.3; }
        .condiciones ul { padding-left: 14px; margin: 4px 0; }
        .condiciones li { margin-bottom: 1px; }
        .firmas { display: flex; justify-content: space-around; margin-top: 24px; }
        .firma { text-align: center; width: 200px; }
        .linea { border-bottom: 1px solid #333; height: 28px; }
        .print-only-firma-label { font-size: 8px; font-weight: 700; margin-top: 4px; }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h1>CONTRATO ${c.Folio || ''}</h1>
            <div style="font-size:9px; color:#666;">Fecha de autorización: ${fechaAut}</div>
        </div>
        <div style="font-size:9px; color:#666;">Estatus: ${c.Estatus || 'Activo'}</div>
    </div>

    <h2>DATOS DEL PRESTADOR DE SERVICIOS</h2>
    <div class="grid">
        <div class="campo"><label>EMPRESA</label><span>SANEAMIENTO SANA</span></div>
        <div class="campo"><label>CIF / RFC</label><span>SANA010101XYZ</span></div>
        <div class="campo"><label>NOMBRE COMERCIAL</label><span>SANEAMIENTO SANA</span></div>
        <div class="campo"><label>TELÉFONO</label><span>999 000 0000</span></div>
        <div class="campo"><label>DOMICILIO FISCAL</label><span>CARRETERA MERIDA - CHALMUCH KM. 1.3</span></div>
        <div class="campo"><label>CORREO DE ATENCIÓN</label><span>${SANA_DATA.correo}</span></div>
    </div>

    <h2>DATOS DEL CLIENTE</h2>
    <div class="grid">
        <div class="campo"><label>RAZÓN SOCIAL</label><span>${getProp(p, 'nombre', 'RazonSocial') || c.RazonSocial || '—'}</span></div>
        <div class="campo"><label>RFC</label><span>${getProp(p, 'rfc', 'RFC') || c.RFC || '—'}</span></div>
        <div class="campo"><label>NOMBRE COMERCIAL</label><span>${getProp(p, 'nombreComercial', 'Nombre_Comercial') || c.RazonSocial || '—'}</span></div>
        <div class="campo"><label>REPRESENTANTE LEGAL</label><span>${representante}</span></div>
        <div class="campo"><label>DOMICILIO FISCAL</label><span>${domicilioFiscal}</span></div>
        <div class="campo"><label>DOMICILIO DE RECOLECCIÓN</label><span>${domicilioRecoleccion}</span></div>
        <div class="campo"><label>TELÉFONO DE CONTACTO</label><span>${getProp(p, 'telefono', 'Telefono') || c.Telefono || '—'}</span></div>
        <div class="campo"><label>CORREO COMERCIAL</label><span>${getProp(p, 'email', 'Correo') || c.Correo || '—'}</span></div>
        <div class="campo"><label>FOLIO CATASTRAL</label><span>${getProp(p, 'folioCatastral', 'Folio_Catastral') || c.Folio_Catastral || '—'}</span></div>
    </div>

    <h2>SERVICIOS COTIZADOS</h2>
    ${serviciosHtml || '<p style="color:#999; font-size:9px;">Sin servicios cotizados.</p>'}

    <div class="summary">
        <div class="summary-row"><span>SUBTOTAL SERVICIOS (${domiciliosActivos} DOMICILIOS)</span><strong>${formatMXN(subtotalGlobal + descuentoGlobal)}</strong></div>
        <div class="summary-row"><span>DESCUENTO</span><strong style="color:#C62828;">-${formatMXN(descuentoGlobal)}</strong></div>
        <div class="summary-row"><span>IVA</span><strong>${formatMXN(ivaGlobal)}</strong></div>
        <div class="summary-total"><span>TOTAL MENSUAL ESTIMADO</span><span>${formatMXN(totalGlobal)}</span></div>
    </div>

    <h2>CONDICIONES DEL SERVICIO</h2>
    <div class="condiciones">
        <ul>
            <li>Contamos con certificaciones de calidad y cumplimiento ambiental.</li>
            <li>Después de 15 días sin firma de autorización, los costos están sujetos a cambio sin previo aviso.</li>
            <li>La primera facturación es por un semestre, posteriormente puede ser mensual o trimestral.</li>
            <li>Contrato a un año, independientemente del periodo de pago.</li>
            <li>Servicio colectivo de recolección de los residuos sólidos urbanos en unidad con CAJA COMPACTADORA.</li>
            <li>Servicio proporcionado por un operador y dos recolectores.</li>
        </ul>
    </div>

    <div class="firmas">
        <div class="firma">
            <div class="linea"></div>
            <div class="print-only-firma-label">NOMBRE DEL REPRESENTANTE<br/>SANEAMIENTO SANA SA DE CV</div>
        </div>
        <div class="firma">
            <div class="linea"></div>
            <div class="print-only-firma-label">NOMBRE DEL REPRESENTANTE<br/>EMPRESA A BRINDAR SERVICIO</div>
        </div>
    </div>
</body>
</html>`;

            let iframe = document.getElementById('printFrameContrato');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'printFrameContrato';
                iframe.style.position = 'fixed';
                iframe.style.width = '1px';
                iframe.style.height = '1px';
                iframe.style.border = 'none';
                iframe.style.top = '-1000px';
                document.body.appendChild(iframe);
            }
            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(html);
            doc.close();
            setTimeout(() => {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
            }, 500);
        }

        function enviarContrato() {
            if (!contratoActual) return;
            Swal.fire({
                title: '¿Enviar contrato?',
                text: 'El estatus cambiará a "Enviado".',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#D84315'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("EnviarContrato", "Contratos")/' + contratoActual.Contrato_ID, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                    }).then(r => r.json()).then(res => {
                        if (res.success) {
                            Swal.fire('Enviado', res.message, 'success').then(() => {
                                cerrarModal();
                                cargarContratos();
                            });
                        } else {
                            Swal.fire('Error', res.error, 'error');
                        }
                    }).catch(console.error);
                }
            });
        }

        function enviarRevision() {
            if (!contratoActual) return;
            Swal.fire({
                title: '¿Enviar a revisión?',
                text: 'El supervisor revisará el contrato.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#E65100'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("EnviarARevision", "Contratos")/' + contratoActual.Contrato_ID, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                    }).then(r => {
                        if (!r.ok) {
                            return r.text().then(text => { throw new Error('HTTP ' + r.status + ': ' + (text || 'Error del servidor')); });
                        }
                        const ct = r.headers.get('content-type') || '';
                        if (!ct.includes('application/json')) {
                            return r.text().then(text => { throw new Error('Respuesta no válida: ' + (text.substring(0, 200) || 'respuesta vacía')); });
                        }
                        return r.json();
                    }).then(res => {
                        if (res.success) {
                            Swal.fire('Enviado', res.message, 'success').then(() => {
                                cerrarModal();
                                cargarContratos();
                            });
                        } else {
                            Swal.fire('Error', res.error || 'Ocurrió un error inesperado.', 'error');
                        }
                    }).catch(err => {
                        console.error(err);
                        Swal.fire('Error', err.message || 'No se pudo enviar a revisión. Revisa la consola o terminal de IIS Express.', 'error');
                    });
                }
            });
        }

        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && $('#modalContrato').hasClass('show')) {
                cerrarModal();
            }
        });
    </script>
}
