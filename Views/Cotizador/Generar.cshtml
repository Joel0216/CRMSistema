@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Generar cotización";
    ViewBag.ActiveMenu = "Cotizador";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="section-title mb-0" style="text-transform: uppercase;">Generar Nueva Cotización</h2>
    </div>
    <div class="d-flex gap-3">
        <div>
            <label style="font-size: 11px; font-weight: 700; color: var(--text3);">Fecha de inicio</label>
            <input type="date" class="form-input form-control form-control-sm" id="fechaInicio" disabled style="width: 150px;">
        </div>
        <div>
            <label style="font-size: 11px; font-weight: 700; color: var(--text3);">Fecha límite</label>
            <input type="date" class="form-input form-control form-control-sm" id="fechaLimite" style="width: 150px;">
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm align-self-end h-auto mt-auto py-1">
            <i class="fas fa-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div id="loaderCotizador" class="text-center py-5">
    <div class="spinner-border text-primary" role="status"></div>
    <p class="mt-2 text-muted">Cargando datos del cliente...</p>
</div>

<div id="cotizadorContainer" style="display: none;">
    <!-- INFORMACIÓN DEL CLIENTE (MATRIZ) -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header text-uppercase fw-bold" style="background-color: #f8f9fa;">Información del cliente (Matriz)</div>
        <div class="card-body" style="padding: 20px;">
            <div class="row g-3" id="prospectoInfoContainer">
                <!-- Data will be injected here via JS -->
            </div>
            <div class="mt-3 p-3 rounded d-flex align-items-center gap-2" style="background: #E3F2FD; color: #1565C0; font-size: 13px;">
                <span>ℹ️</span> Selecciona una pestaña para cotizar cada domicilio de servicio. El resumen final consolida todos los subtotales.
            </div>
        </div>
    </div>

    <!-- TABS -->
    <div id="tabsContainer" style="display: flex; gap: 4px; margin-bottom: 20px; overflow-x: auto;">
        <!-- Tabs will be rendered here -->
    </div>

    <!-- CONTENIDO DE LA PESTAÑA -->
    <div class="card mb-4 shadow-sm" style="border-top-left-radius: 0;">
        <div class="card-header fw-bold" style="color: #E65100; background: transparent; border-bottom: 1px solid #eee;">VERIFICACIÓN DEL DOMICILIO Y DÍAS DE SERVICIO DISPONIBLES</div>
        <div class="card-body" style="padding: 20px; display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px;">
            <div id="mapaView" style="height: 200px; border-radius: 8px; overflow: hidden; border: 1px solid #CFD8DC; background-color: #e9ecef; z-index: 1;">
                <!-- Map loads here -->
            </div>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div>
                    <label class="form-label" style="font-size: 12px;">Domicilio de Servicio</label>
                    <input class="form-control form-control-sm" id="activeDomicilio" disabled style="background: #f9f9f9;" />
                </div>
                <div class="d-flex gap-3">
                    <div class="flex-fill">
                        <label class="form-label" style="font-size: 12px;">Latitud</label>
                        <input class="form-control form-control-sm" id="activeLat" disabled style="background: #f9f9f9;" />
                    </div>
                    <div class="flex-fill">
                        <label class="form-label" style="font-size: 12px;">Longitud</label>
                        <input class="form-control form-control-sm" id="activeLng" disabled style="background: #f9f9f9;" />
                    </div>
                </div>
                <div>
                    <label class="form-label" style="font-size: 12px;">Adeudo del domicilio</label>
                    <input class="form-control form-control-sm" value="$0.00" disabled style="background: #E8F5E9; color: #2E7D32; font-weight: 700;" />
                </div>
            </div>
        </div>

        <div class="card-header fw-bold" style="color: #E65100; background: transparent; border-bottom: 1px solid #eee; border-top: 1px solid #eee;">SERVICIOS A COTIZAR</div>

        <div class="card-body" style="padding: 20px; overflow-x: auto;">
            <table class="table mb-0" style="border: 1px solid #5D4037;">
                <thead style="background: #F5EFE9; color: #5D4037;">
                    <tr>
                        <th style="font-size: 11px; font-weight: 700; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">Tipo</th>
                        <th style="font-size: 11px; font-weight: 700; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">Servicio</th>
                        <th style="font-size: 11px; font-weight: 700; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">Detalles del Servicio</th>
                        <th style="font-size: 11px; font-weight: 700; text-align: center; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">Días</th>
                        <th style="font-size: 11px; font-weight: 700; text-align: center; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">Precio Unit.</th>
                        <th style="font-size: 11px; font-weight: 700; text-align: center; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">% Adicional</th>
                        <th style="font-size: 11px; font-weight: 700; text-align: center; border: 1px solid #5D4037; padding: 12px; text-transform: uppercase;">Subtotal</th>
                        <th style="font-size: 11px; font-weight: 700; text-align: center; border: 1px solid #5D4037; padding: 12px;"></th>
                    </tr>
                </thead>
                <tbody id="serviciosTbody" style="background: #fff; color: #333;">
                    <!-- JS injected -->
                </tbody>
            </table>
            <button class="btn btn-link mt-3" style="color: #5D4037; font-weight: 700; text-decoration: none; padding: 0;" onclick="openModalServicio()">+ Agregar servicio</button>
        </div>
    </div>

    <!-- RESUMEN CONSOLIDADO -->
    <div class="card mb-4 shadow-sm" style="border: 2px solid #C4A574;">
        <div class="card-header fw-bold" style="background: #F5EFE9; color: #5D4037;">RESUMEN CONSOLIDADO - TODAS LAS SUCURSALES</div>
        <div class="card-body" style="padding: 20px;">
            <div id="resumenTabsContainer" style="display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px;">
                <!-- JS injected -->
            </div>

            <div style="border-top: 2px dashed #C4A574; margin-top: 16px; padding-top: 16px; width: 400px; margin-left: auto;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <span>Subtotal servicios (todas las sucursales)</span>
                    <span style="font-weight: 600;" id="subtotalGlobalLbl">$0.00</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <span>IVA (16%)</span>
                    <span style="font-weight: 600;" id="ivaGlobalLbl">$0.00</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-top: 16px; font-size: 20px; font-weight: 800; color: #5D4037;">
                    <span>TOTAL MENSUAL</span>
                    <span id="totalGlobalLbl">$0.00</span>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
                <button class="btn btn-outline-secondary" style="border-color: #C4A574; color: #5D4037; font-weight: 600;" onclick="guardarBorrador()">Guardar borrador</button>
                <button class="btn btn-secondary" style="background: #8D6E63; border: none; font-weight: 600;" onclick="descargarPDF()">Descargar PDF</button>
                <button class="btn btn-primary" style="background: #4E342E; border: none; font-weight: 600;" onclick="guardarCotizacion()" id="btnGuardar">Enviar al cliente</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Agregar Servicio -->
<div class="modal fade" id="modalServicio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: #4A2C0A; color: white; border-bottom: none;">
                <h5 class="modal-title" style="font-size: 14px; text-transform: uppercase;">AGREGAR SERVICIO</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" style="font-size: 12px;">PRODUCTO (Tipo Servicio)</label>
                        <select class="form-select form-select-sm" id="mdlTipoServicio" onchange="toggleModalFields()">
                            <option value="RSU">RSU</option>
                            <option value="RME">RME</option>
                        </select>
                    </div>
                    
                    <div class="col-md-8 rsu-field">
                        <label class="form-label" style="font-size: 12px;">TIPO DE RESIDUO</label>
                        <select class="form-select form-select-sm" id="mdlCodigoControl"></select>
                    </div>

                    <div class="col-md-4 rme-field" style="display: none;">
                        <label class="form-label" style="font-size: 12px;">TIPO DE UNIDAD</label>
                        <select class="form-select form-select-sm" id="mdlTipoUnidad" onchange="updateUnidadInfo()"></select>
                    </div>
                    <div class="col-md-4 rme-field" style="display: none;">
                        <label class="form-label" style="font-size: 12px;">TIPO DE SERVICIO</label>
                        <select class="form-select form-select-sm" id="mdlTipoCobro">
                            <option value="">-- Selecciona --</option>
                            <option value="VIAJE">VIAJE</option>
                            <option value="PESO">PESO</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6 rsu-field">
                        <label class="form-label" style="font-size: 12px;">BOLSAS CONTRATADAS POR DÍA</label>
                        <input type="number" class="form-control form-control-sm" id="mdlBolsas" value="20" min="1">
                    </div>

                    <div class="col-md-6 rme-field" style="display: none;">
                        <label class="form-label" style="font-size: 12px;">NO. RECOLECCIONES / DÍA</label>
                        <input type="number" class="form-control form-control-sm" id="mdlRecolectores" value="1" min="1">
                    </div>
                    <div class="col-md-6 rme-field" style="display: none;">
                        <label class="form-label" style="font-size: 12px;">TURNO</label>
                        <select class="form-select form-select-sm" id="mdlTurno">
                            <option value="">-- Selecciona --</option>
                            <option value="MAÑANA">MAÑANA</option>
                            <option value="TARDE">TARDE</option>
                            <option value="NOCHE">NOCHE</option>
                        </select>
                    </div>
                </div>

                <div class="rme-field mb-3 p-3 rounded" style="display: none; background: #F1F8E9; border: 1px solid #C5E1A5;">
                    <h6 style="font-size: 13px; color: #33691E; font-weight: bold;">CONFIGURADOR DE COSTOS (RME)</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 12px;">COSTO UNITARIO DEL SERVICIO</label>
                            <input type="number" class="form-control form-control-sm" id="mdlCostoTonelada" value="0" disabled style="background: #f5f5f5;">
                            <small class="text-muted" style="font-size: 10px;">Asignado automáticamente por tipo de unidad.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 12px;">COSTO DISPOSICIÓN EXTRA</label>
                            <input type="number" class="form-control form-control-sm" id="mdlCostoDisposicion" value="0" min="0">
                        </div>
                    </div>
                </div>

                <div>
                    <label class="form-label" style="font-size: 12px;">DÍAS DE RECOLECCIÓN SOLICITADO</label>
                    <div class="d-flex flex-wrap gap-3 mt-2" id="mdlDiasContainer">
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Lunes" class="chk-dia" checked> LUNES
                        </label>
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Martes" class="chk-dia" checked> MARTES
                        </label>
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Miércoles" class="chk-dia" checked> MIÉRCOLES
                        </label>
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Jueves" class="chk-dia" checked> JUEVES
                        </label>
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Viernes" class="chk-dia" checked> VIERNES
                        </label>
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Sábado" class="chk-dia" checked> SÁBADO
                        </label>
                        <label class="d-flex align-items-center gap-1" style="font-size: 13px; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" value="Domingo" class="chk-dia" checked> DOMINGO
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: none;">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal" style="text-decoration: none; color: #888; font-weight: 600;">CANCELAR</button>
                <button type="button" class="btn text-white" style="background: #A16A34; border-radius: 6px; font-weight: 600; padding: 6px 20px;" onclick="addServicio()">AGREGAR</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const prospectoId = @(ViewBag.ProspectoId ?? "null");
        
        let prospectoData = null;
        let sucursalesData = [];
        let serviciosDb = [];
        let unidadesRME = [];
        let mapInstance = null;
        let mapMarker = null;
        
        let items = []; // Array of { id, tab_id, tipo_servicio, ... }
        let activeTab = 'MATRIZ'; // 'MATRIZ' or sucursal id

        const formatMXN = (num) => {
            return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(num || 0);
        };

        $(document).ready(function() {
            if (!prospectoId) {
                window.location.href = '@Url.Action("Index", "Prospectos")';
                return;
            }

            // Set dates
            const today = new Date().toISOString().split('T')[0];
            const nextWeek = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
            $('#fechaInicio').val(today);
            $('#fechaLimite').val(nextWeek);

            // Fetch Data
            Promise.all([
                fetch('@Url.Action("GetProspectos", "Cotizador")').then(r=>r.json()),
                fetch('@Url.Action("GetSucursales", "Cotizador")/' + prospectoId).then(r=>r.json()),
                fetch('@Url.Action("GetServiciosResiduos", "Cotizador")').then(r=>r.json()),
                fetch('@Url.Action("GetConfiguradorUnidades", "Cotizador")').then(r=>r.json()),
                fetch('@Url.Action("GetBorradores", "Cotizador")/' + prospectoId).then(r=>r.json())
            ]).then(([prospectos, sucursales, serviciosRes, unidadesRes, borradoresRes]) => {
                if (prospectos && prospectos.length > 0) {
                    prospectoData = prospectos.find(p => p.id == prospectoId || (p.Id && p.Id == prospectoId));
                    if (!prospectoData) {
                        // Fallback object for UI check
                        prospectoData = prospectos[0];
                    }
                }
                if (sucursales) sucursalesData = sucursales;
                if (serviciosRes && serviciosRes.success) serviciosDb = serviciosRes.data;
                if (unidadesRes && unidadesRes.success) unidadesRME = unidadesRes.data;

                const urlParams = new URLSearchParams(window.location.search);
                const borradorId = urlParams.get('borradorId');
                if (borradorId && borradoresRes && borradoresRes.success && borradoresRes.data) {
                    const borradorStr = borradoresRes.data.find(b => (b.Borrador_ID || b.borrador_id) == borradorId);
                    if (borradorStr && (borradorStr.Datos_Borrador || borradorStr.datos_borrador)) {
                        try {
                            const datos = JSON.parse(borradorStr.Datos_Borrador || borradorStr.datos_borrador);
                            if (datos.items) items = datos.items;
                            if (datos.fechaInicio) $('#fechaInicio').val(datos.fechaInicio);
                            if (datos.fechaLimite) $('#fechaLimite').val(datos.fechaLimite);
                        } catch (e) {
                            console.error('Error parsing borrador:', e);
                        }
                    }
                }

                initUI();
            }).catch(e => {
                console.error(e);
                Swal.fire('Error', 'Hubo un problema al cargar los datos.', 'error');
            });
        });

        function initUI() {
            $('#loaderCotizador').hide();
            if (!prospectoData) {
                $('#cotizadorContainer').html('<div class="alert alert-danger">No se encontró información del prospecto.</div>').show();
                return;
            }
            $('#cotizadorContainer').show();

            // Populate Prospecto Info
            const p = prospectoData;
            // Use property keys carefully as they may be PascalCase or camelCase
            const getVal = (key1, key2) => p[key1] !== undefined ? p[key1] : (p[key2] !== undefined ? p[key2] : '');
            
            const htmlInfo = `
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">Tipo de persona</label><input class="form-control form-control-sm" value="${getVal('tipoPersona','TipoPersona') || 'Moral'}" disabled></div>
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">Razón Social / Nombre completo</label><input class="form-control form-control-sm" value="${getVal('nombre','Nombre')}" disabled></div>
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">RFC</label><input class="form-control form-control-sm" value="${getVal('rfc','Rfc')}" disabled></div>
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">Nombre Comercial</label><input class="form-control form-control-sm" value="${getVal('nombreComercial','NombreComercial')}" disabled></div>
                
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">¿Tiene sucursales?</label><input class="form-control form-control-sm" value="${sucursalesData.length > 0 ? 'SÍ - ' + sucursalesData.length + ' REGISTRADAS' : 'NO'}" disabled></div>
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">Nombre completo de contacto</label><input class="form-control form-control-sm" value="${getVal('contacto','Contacto')}" disabled></div>
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">Teléfono de contacto</label><input class="form-control form-control-sm" value="${getVal('telefono','Telefono')}" disabled></div>
                <div class="col-md-3"><label class="form-label" style="font-size: 12px;">Correo electrónico</label><input class="form-control form-control-sm" value="${getVal('email','Email')}" disabled></div>
            `;
            $('#prospectoInfoContainer').html(htmlInfo);

            renderTabs();
            renderActiveTabContent();
            renderResumen();
            populateModalSelects();
        }

        function renderTabs() {
            const p = prospectoData;
            const getVal = (k1, k2) => p[k1] !== undefined ? p[k1] : (p[k2] !== undefined ? p[k2] : '');
            let tabsHtml = `
                <button onclick="changeTab('MATRIZ')" style="padding: 12px 24px; background: ${activeTab === 'MATRIZ' ? '#5D4037' : '#D7CCC8'}; color: ${activeTab === 'MATRIZ' ? '#fff' : '#5D4037'}; border: none; border-radius: 8px 8px 0 0; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px;">
                    🏢 MATRIZ - ${getVal('nombreComercial', 'NombreComercial') || getVal('nombre', 'Nombre')}
                </button>
            `;
            sucursalesData.forEach((s, idx) => {
                const sId = (s.id || s.Id).toString();
                const num = String(idx+1).padStart(3,'0');
                const nom = s.nombre_sucursal || s.NombreSucursal;
                tabsHtml += `
                    <button onclick="changeTab('${sId}')" style="padding: 12px 24px; background: ${activeTab === sId ? '#5D4037' : '#D7CCC8'}; color: ${activeTab === sId ? '#fff' : '#5D4037'}; border: none; border-radius: 8px 8px 0 0; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px;">
                        🏢 SUC. ${num} - ${nom}
                    </button>
                `;
            });
            $('#tabsContainer').html(tabsHtml);
        }

        function changeTab(tabId) {
            activeTab = tabId;
            renderTabs();
            renderActiveTabContent();
        }

        function renderActiveTabContent() {
            let lat, lng, dom;
            if (activeTab === 'MATRIZ') {
                const p = prospectoData;
                const getVal = (k1, k2) => p[k1] !== undefined ? p[k1] : (p[k2] !== undefined ? p[k2] : '');
                dom = [getVal('calle','Calle'), getVal('numExt','NumExt'), getVal('colonia','Colonia'), getVal('municipio','Municipio')].filter(Boolean).join(', ');
                lat = getVal('lat','Lat');
                lng = getVal('lng','Lng');
            } else {
                const s = sucursalesData.find(x => (x.id || x.Id).toString() === activeTab);
                if (s) {
                    dom = s.direccion || [s.calle || s.Calle, s.numExt || s.NumExt, s.colonia || s.Colonia, s.municipio || s.Municipio].filter(Boolean).join(', ');
                    lat = s.lat || s.Lat;
                    lng = s.lng || s.Lng;
                }
            }

            $('#activeDomicilio').val(dom || 'N/A');
            $('#activeLat').val(lat || '');
            $('#activeLng').val(lng || '');

            updateMap(lat, lng);
            renderTable();
        }

        function updateMap(lat, lng) {
            const mapDiv = document.getElementById('mapaView');
            if (!lat || !lng) {
                if (mapInstance) { mapInstance.remove(); mapInstance = null; }
                mapDiv.innerHTML = '<div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#999;"><i class="fas fa-map-marker-alt"></i> Coordenadas no disponibles</div>';
                return;
            }

            if (!mapInstance) {
                mapDiv.innerHTML = '';
                mapInstance = L.map('mapaView').setView([lat, lng], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19
                }).addTo(mapInstance);
                mapMarker = L.marker([lat, lng]).addTo(mapInstance);
            } else {
                mapInstance.setView([lat, lng], 15);
                if (mapMarker) mapMarker.setLatLng([lat, lng]);
            }
        }

        function renderTable() {
            const activeItems = items.filter(i => i.tab_id === activeTab);
            let html = '';
            if (activeItems.length === 0) {
