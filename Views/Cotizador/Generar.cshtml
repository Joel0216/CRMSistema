                        return `<span style="background: ${bg}; color: ${col}; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 700;">${d.substring(0,3)}</span>`;
                    }).join(' ');

                    const pu = isRSU ? formatMXN(18.60) : formatMXN(getPrecioUnitarioRME(it));
                    const puColor = isRSU ? '#333' : '#2E7D32';

                    html += `
