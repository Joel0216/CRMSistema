        function getPrecioUnitarioRME(i) {
            return (Number(i.costo_tonelada) || 0) + (Number(i.costo_disposicion) || 0);
        }

        function calcularSubtotalItem(i) {
            if (i.tipo_servicio === 'RSU') {
                const diasPorSemana = Array.isArray(i.dias_asignados) ? i.dias_asignados.length : 1;
                const bolsasMensuales = (i.bolsas * diasPorSemana * 52) / 12;
                return bolsasMensuales * 18.60 * (1 + (i.porcentaje_adicional || 0)/100);
            } else {
                const viajesMensuales = i.recolectores * i.dias_asignados.length * 4;
                const costo_por_viaje = getPrecioUnitarioRME(i);
                const subtotalBase = costo_por_viaje * viajesMensuales;
                return subtotalBase * (1 + (i.porcentaje_adicional || 0)/100);
            }
        }

        function updatePorcentaje(id, val) {
            const it = items.find(x => x.id === id);
            if (it) {
                it.porcentaje_adicional = Number(val) || 0;
                renderTable();
            }
        }

        function removeItem(id) {
            items = items.filter(x => x.id !== id);
            renderTable();
        }

        function renderResumen() {
            const subtotalForTab = (tabId) => items.filter(i => i.tab_id === tabId).reduce((s, i) => s + calcularSubtotalItem(i), 0);
            
            const p = prospectoData;
            const getVal = (k1, k2) => p[k1] !== undefined ? p[k1] : (p[k2] !== undefined ? p[k2] : '');
            let h = `
                <div style="min-width: 200px; padding: 16px; border: 1px solid #E0E0E0; border-radius: 8px; background: #FAFAFA;">
                    <div style="font-size: 12px; font-weight: 700; color: #5D4037; margin-bottom: 8px;">🏢 MATRIZ - ${getVal('nombreComercial','NombreComercial') || getVal('nombre','Nombre')}</div>
                    <div style="font-size: 18px; font-weight: 800;">${formatMXN(subtotalForTab('MATRIZ'))}</div>
                    <div style="font-size: 11px; color: #999;">${items.filter(i=>i.tab_id === 'MATRIZ').length} Servicios</div>
                </div>
            `;
            sucursalesData.forEach((s, idx) => {
                const sId = (s.id || s.Id).toString();
                h += `
                    <div style="min-width: 200px; padding: 16px; border: 1px solid #E0E0E0; border-radius: 8px; background: #FAFAFA;">
                        <div style="font-size: 12px; font-weight: 700; color: #5D4037; margin-bottom: 8px;">🏢 SUC. ${String(idx+1).padStart(3,'0')}</div>
                        <div style="font-size: 18px; font-weight: 800;">${formatMXN(subtotalForTab(sId))}</div>
                        <div style="font-size: 11px; color: #999;">${items.filter(i=>i.tab_id === sId).length} Servicios</div>
                    </div>
                `;
            });
            $('#resumenTabsContainer').html(h);

            const subGlobal = items.reduce((s, i) => s + calcularSubtotalItem(i), 0);
            const iva = subGlobal * 0.16;
            const total = subGlobal + iva;

            $('#subtotalGlobalLbl').text(formatMXN(subGlobal));
            $('#ivaGlobalLbl').text(formatMXN(iva));
            $('#totalGlobalLbl').text(formatMXN(total));
        }

        // --- Modal functions ---
        function populateModalSelects() {
            let rsuHtml = '<option value="">-- Selecciona --</option>';
            serviciosDb.filter(s => s.codigo_sana && s.codigo_sana.startsWith('RSU')).forEach(s => {
                rsuHtml += `<option value="${s.codigo_control}">${s.descripcion}</option>`;
            });
            $('#mdlCodigoControl').html(rsuHtml);

            let rmeHtml = '<option value="">-- Selecciona --</option>';
            unidadesRME.forEach(u => {
                rmeHtml += `<option value="${u.Nombre_Unidad}">${u.Nombre_Unidad} - ${formatMXN(u.Costo_Unitario)}</option>`;
            });
            $('#mdlTipoUnidad').html(rmeHtml);
        }

        function openModalServicio() {
            $('#mdlTipoServicio').val('RSU');
            toggleModalFields();
            $('#mdlCodigoControl').val('');
            $('#mdlBolsas').val(20);
            $('.chk-dia').prop('checked', true);
            var myModal = new bootstrap.Modal(document.getElementById('modalServicio'));
            myModal.show();
        }

        function toggleModalFields() {
            const t = $('#mdlTipoServicio').val();
            if (t === 'RSU') {
                $('.rsu-field').show();
                $('.rme-field').hide();
            } else {
                $('.rsu-field').hide();
                $('.rme-field').show();
            }
        }

        function updateUnidadInfo() {
            const nom = $('#mdlTipoUnidad').val();
            const u = unidadesRME.find(x => x.Nombre_Unidad === nom);
            if (u) {
                $('#mdlCostoTonelada').val(u.Costo_Unitario);
            } else {
                $('#mdlCostoTonelada').val(0);
            }
        }

        function addServicio() {
            const tipo = $('#mdlTipoServicio').val();
            const dias = [];
            $('.chk-dia:checked').each(function() { dias.push($(this).val()); });
            
            if (dias.length === 0) {
                Swal.fire('Atención', 'Selecciona al menos un día de recolección.', 'warning');
                return;
            }

            let newItem = {
                id: Date.now(),
                tab_id: activeTab,
                tipo_servicio: tipo,
                dias_asignados: dias,
                porcentaje_adicional: 0
            };

            if (tipo === 'RSU') {
                const cod = $('#mdlCodigoControl').val();
                if (!cod) return Swal.fire('Falta residuo', 'Selecciona un tipo de residuo.', 'warning');
                const serv = serviciosDb.find(s => s.codigo_control === cod);
                
                newItem.codigo_control = cod;
                newItem.tipo_residuo = serv ? serv.descripcion : 'RSU';
                newItem.bolsas = Number($('#mdlBolsas').val()) || 1;
                newItem.precio_unitario = 18.60;
                
            } else {
                newItem.tipo_residuo = 'Residuos de Manejo Especial';
                newItem.tipo_unidad = $('#mdlTipoUnidad').val();
                newItem.tipo_cobro = $('#mdlTipoCobro').val();
                newItem.recolectores = Number($('#mdlRecolectores').val()) || 1;
                newItem.turno = $('#mdlTurno').val();
                newItem.costo_tonelada = Number($('#mdlCostoTonelada').val()) || 0;
                newItem.costo_disposicion = Number($('#mdlCostoDisposicion').val()) || 0;
                
                if (!newItem.tipo_unidad) return Swal.fire('Atención', 'Selecciona un tipo de unidad RME.', 'warning');
                if (!newItem.tipo_cobro) return Swal.fire('Atención', 'Selecciona un tipo de servicio (cobro).', 'warning');
            }

            items.push(newItem);
            renderTable();
            
            bootstrap.Modal.getInstance(document.getElementById('modalServicio')).hide();
        }

        // --- Save and APIs ---
        function guardarBorrador() {
            if (items.length === 0) return Swal.fire('Atención', 'Agrega al menos un servicio.', 'warning');
            const subGlobal = items.reduce((s, i) => s + calcularSubtotalItem(i), 0);
            const datos = {
                fechaInicio: $('#fechaInicio').val(),
                fechaLimite: $('#fechaLimite').val(),
                items: items,
                totales: { subtotal: subGlobal, iva: subGlobal * 0.16, total: subGlobal * 1.16 }
            };
            
            fetch('@Url.Action("CreateBorrador", "Cotizador")', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: prospectoId, datos: JSON.stringify(datos) })
            }).then(r=>r.json()).then(res => {
                if (res.success) {
                    Swal.fire({icon:'success', title:'Borrador guardado correctamente', toast:true, position:'top-end', timer:2000, showConfirmButton:false});
                } else {
                    Swal.fire('Error', res.error, 'error');
                }
            }).catch(console.error);
        }

