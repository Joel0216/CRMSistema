        function guardarCotizacion() {
            if (items.length === 0) return Swal.fire('Atención', 'Agrega al menos un servicio.', 'warning');
            
            $('#btnGuardar').prop('disabled', true).text('Enviando...');
            
            const subGlobal = items.reduce((s, i) => s + calcularSubtotalItem(i), 0);
            const totalGlobal = subGlobal * 1.16;
            const p = prospectoData;
            const getVal = (k1, k2) => p[k1] !== undefined ? p[k1] : (p[k2] !== undefined ? p[k2] : '');

            // 1. Create Trato
            fetch('@Url.Action("CreateTrato", "Cotizador")', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    prospecto_id: prospectoId,
                    nombre_trato: 'Cotización CRM',
                    importe: totalGlobal,
                    fase_id: 2,
                    fecha_limite_cotizacion: $('#fechaLimite').val()
                })
            }).then(r=>r.json()).then(res => {
                if (!res.success) throw new Error(res.error);
                const tratoId = res.id;
                
                // 2. Create Servicios Cotizados (sequential promises)
                let promiseChain = Promise.resolve();
                items.forEach(it => {
                    promiseChain = promiseChain.then(() => {
                        return fetch('@Url.Action("CreateServicioCotizado", "Cotizador")', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                trato_id: tratoId,
                                tipo_residuo: it.tipo_residuo,
                                frecuencia: 'Mensual',
                                periodicidad_pago: 'Mensual',
                                volumen_estimado: it.tipo_servicio === 'RSU' ? it.bolsas : it.recolectores,
                                precio_unitario: it.tipo_servicio === 'RSU' ? 18.60 : getPrecioUnitarioRME(it),
                                dias_asignados: it.dias_asignados.join(','),
                                porcentaje_adicional: it.porcentaje_adicional,
                                sucursal_id: it.tab_id === 'MATRIZ' ? null : it.tab_id, // Adjust this based on DB logic
                                tipo_unidad: it.tipo_unidad,
                                tipo_cobro: it.tipo_cobro,
                                recolectores: it.recolectores,
                                turno: it.turno,
                                ruta: 'Por asignar'
                            })
                        }).then(r=>r.json()).then(sRes => {
                            if (!sRes.success) throw new Error(sRes.error);
                        });
                    });
                });
                
                return promiseChain.then(() => {
                    // 3. Send Email
                    return fetch('@Url.Action("EnviarCotizacion", "Cotizador")', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            prospecto_id: prospectoId,
                            email: getVal('email','Email') || 'sin-correo@crm.com',
                            nombre: getVal('nombre','Nombre') || 'Cliente CRM'
                        })
                    }).then(r=>r.json());
                });
            })
            .then(emailRes => {
                Swal.fire({
                    icon: 'success',
                    title: 'Cotización enviada',
                    html: `Se envió el correo al cliente.<br><br>Contraseña generada: ${emailRes.password_temporal || 'N/A'}<br><br>El estatus cambió a "Cotizado".`,
                    timer: 6000,
                    showConfirmButton: true
                }).then(() => {
                    window.location.href = '@Url.Action("Index", "Cotizador")';
                });
            })
            .catch(e => {
                console.error(e);
                Swal.fire('Error', e.message || 'Error al guardar la cotización', 'error');
                $('#btnGuardar').prop('disabled', false).text('Enviar al cliente');
            });
        }
    </script>
}
