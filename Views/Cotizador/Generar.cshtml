                                <span style="color: #666;">Unidad:</span><span style="color: #3498DB; font-weight: 700;">${it.tipo_unidad || 'N/A'}</span>
                                <span style="color: #666;">Tipo Serv:</span><span style="color: #8E44AD; font-weight: 700;">${it.tipo_cobro === 'PESO' ? 'Peso' : 'Viaje'}</span>
                                <span style="color: #666;">Recorrido:</span><span style="background: #f0f0f0; border-radius: 4px; padding: 2px 6px; font-weight: 600; width: fit-content; color: #666;">Config</span>
                                <span style="color: #666;">Recolecciones:</span><span style="font-weight: 700; color: #333;">${it.recolectores}/día</span>
                                <span style="color: #666;">Turno:</span><span style="color: #E67E22; font-weight: 700; text-transform: capitalize;">${(it.turno || '').toLowerCase()}</span>
