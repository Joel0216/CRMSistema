                            <td style="padding: 16px; vertical-align: middle; border: 1px solid #eee;"><span style="background: ${badgeColor}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700;">${it.tipo_servicio}</span></td>
