                            </td>
                            <td style="padding: 16px; text-align: center; font-weight: 700; font-size: 12px; color: #2E7D32; vertical-align: middle; border: 1px solid #eee;">${formatMXN(calcularSubtotalItem(it))}</td>
                            <td style="padding: 16px; text-align: center; vertical-align: middle; border: 1px solid #eee;">
                                <button type="button" style="background: transparent; border: none; font-size: 18px; cursor: pointer;" onclick="removeItem(${it.id})">
