@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Usuarios";
    ViewBag.ActiveMenu = "Usuarios";
}

<style>
    .estatus-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        display: inline-block;
    }
    .btn-icon {
        border: none;
        background: transparent;
        color: #5D4037;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
    }
    .btn-icon:hover { background: #f0f0f0; }

    .rol-badge {
        background: #4E342E;
        color: white;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }
    .rol-superadmin { background: #C62828; }
    .rol-jefe { background: #6A1B9A; }
    .rol-coordinador { background: #E65100; }
    .rol-supervisor { background: #1565C0; }
    .rol-vendedor { background: #2E7D32; }

    /* Modal de usuario al estilo prospecto */
    #modalUsuarioOverlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        background: rgba(63,40,26,0.50);
        backdrop-filter: blur(3px);
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
    }
    #modalUsuarioOverlay.show { display: flex; }
    .modal-usuario-box {
        background: white;
        border-radius: 14px;
        width: 850px;
        max-width: 95%;
        max-height: 95vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 32px rgba(63,40,26,0.15);
        overflow: hidden;
    }
    .modal-usuario-header {
        background: #4E342E;
        color: white;
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }
    .modal-usuario-title { font-size: 16px; font-weight: 700; text-transform: uppercase; }
    .modal-usuario-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }
    .modal-usuario-section {
        font-size: 12px;
        font-weight: 800;
        color: #5D4037;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 24px 0 14px;
        border-bottom: 1px solid #EDE4D8;
        padding-bottom: 6px;
    }
    .modal-usuario-section:first-child { margin-top: 0; }
    .modal-usuario-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .modal-usuario-footer {
        padding: 16px 24px;
        border-top: 1px solid #EDE4D8;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-shrink: 0;
        background: #FAF6F1;
    }
    @@media (max-width: 767.98px) {
        #modalUsuarioOverlay { padding: 0; }
        .modal-usuario-box {
            width: 100%;
            max-width: 100%;
            height: 100vh;
            max-height: 100vh;
            border-radius: 0;
        }
        .modal-usuario-header { border-radius: 0; }
        .modal-usuario-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="section-title mb-0"><i class="fas fa-user-cog me-2"></i>Usuarios</h2>
        <p class="section-sub mb-0" id="lblCount">Cargando...</p>
    </div>
    <button class="btn" style="background:#4E342E;color:white;border:none;border-radius:8px;padding:8px 16px;font-weight:600;" onclick="abrirModal()">
        <i class="fas fa-plus me-2"></i>Nuevo usuario
    </button>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="table" id="tblUsuarios">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th style="text-align:center;">Estatus</th>
                    <th style="text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbUsuarios">
                <tr><td colspan="6" class="text-center py-4">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Usuario -->
<div id="modalUsuarioOverlay" onclick="cerrarModalUsuario(event)">
    <div class="modal-usuario-box" onclick="event.stopPropagation()">
        <div class="modal-usuario-header">
            <h5 class="modal-usuario-title" id="modalTitulo">Nuevo Usuario</h5>
            <button type="button" onclick="cerrarModalUsuario()" style="background:rgba(255,255,255,0.2); color:white; border:none; border-radius:6px; padding:4px 12px; font-weight:600;">Cerrar</button>
        </div>
        <div class="modal-usuario-body">
            <input type="hidden" id="uId" value="0" />
            <div class="modal-usuario-section">Informaci&oacute;n personal</div>
            <div class="modal-usuario-grid">
                <div class="form-group">
                    <label class="form-label">Nombre(s) *</label>
                    <input type="text" class="form-control form-control-sm" id="uNombre" placeholder="Nombre(s)" />
                </div>
                <div class="form-group">
                    <label class="form-label">Apellido(s)</label>
                    <input type="text" class="form-control form-control-sm" id="uApellidos" placeholder="Apellido(s)" />
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="form-label">Correo electr&oacute;nico *</label>
                    <input type="email" class="form-control form-control-sm" id="uCorreo" placeholder="correo@ejemplo.com" />
                </div>
            </div>
            <div class="modal-usuario-section">Acceso y rol</div>
            <div class="modal-usuario-grid">
                <div class="form-group">
                    <label class="form-label">Nombre de usuario (login) *</label>
                    <input type="text" class="form-control form-control-sm" id="uUsuario" placeholder="usuario" />
                </div>
                <div class="form-group" id="colPassword">
                    <label class="form-label">Contrase&ntilde;a *</label>
                    <input type="password" class="form-control form-control-sm" id="uPassword" placeholder="Contrase&ntilde;a temporal" />
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="form-label">Rol *</label>
                    <select class="form-select form-select-sm" id="uRol">
                        <option value="">-- Seleccionar --</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-usuario-footer">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cerrarModalUsuario()">Cancelar</button>
            <button type="button" class="btn btn-success btn-sm" onclick="guardarUsuario()">Guardar usuario</button>
        </div>
    </div>
</div>

<!-- Modal Cambiar Contraseña -->
<div class="modal fade" id="modalPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#4E342E;color:white;">
                <h5 class="modal-title" style="font-size:15px;font-weight:700;text-transform:uppercase;">Restablecer Contraseña</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pId" value="0" />
                <p style="font-size:13px;color:#424242;">
                    Estás restableciendo la contraseña del usuario <strong id="pNombre"></strong>.
                </p>
                <label class="form-label">Nueva contraseña *</label>
                <input type="password" class="form-control form-control-sm" id="pPassword" placeholder="Contraseña temporal" />
            </div>
            <div class="modal-footer" style="border-top:1px solid #eee;">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning btn-sm" onclick="guardarPassword()">Restablecer contraseña</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let usuarios = [];
        let roles = [];
        let usuarioActualId = 0;

        $(document).ready(function() {
            cargarRoles().then(cargarUsuarios);
        });

        function cargarRoles() {
            return fetch('@Url.Action("GetRoles", "Usuarios")', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(res => {
                    roles = res.success ? (res.data || []) : [];
                    let html = '<option value="">-- Seleccionar --</option>';
                    roles.forEach(r => {
                        html += `<option value="${r.id}">${r.nombre}</option>`;
                    });
                    $('#uRol').html(html);
                })
                .catch(console.error);
        }

        function cargarUsuarios() {
            fetch('@Url.Action("GetUsuarios", "Usuarios")', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        usuarios = res.data || [];
                        renderizarTabla();
                    } else {
                        $('#tbUsuarios').html(`<tr><td colspan="6" class="text-center text-danger py-4">${res.error || 'Error al cargar'}</td></tr>`);
                    }
                })
                .catch(e => {
                    console.error(e);
                    $('#tbUsuarios').html('<tr><td colspan="6" class="text-center text-danger py-4">Error al cargar datos</td></tr>');
                });
        }

        function renderizarTabla() {
            const activos = usuarios.filter(u => u.activo).length;
            $('#lblCount').text(`${usuarios.length} usuarios registrados (${activos} activos)`);

            if (usuarios.length === 0) {
                $('#tbUsuarios').html('<tr><td colspan="6" class="text-center py-4">No hay usuarios registrados.</td></tr>');
                return;
            }

            let html = '';
            usuarios.forEach(u => {
                const rolSlug = (u.rol || '').toLowerCase().replace(' ', '');
                const rolClass =
                    rolSlug === 'superadmin' ? 'rol-superadmin' :
                    rolSlug === 'jefe' ? 'rol-jefe' :
                    rolSlug === 'coordinador' ? 'rol-coordinador' :
                    rolSlug === 'supervisor' ? 'rol-supervisor' : 'rol-vendedor';
                const estatus = u.activo
                    ? '<span class="estatus-badge" style="background:#E8F5E9;color:#2E7D32;">Activo</span>'
                    : '<span class="estatus-badge" style="background:#EEEEEE;color:#616161;">Inactivo</span>';

                const btnActivar = u.activo ? '' : `<button class="btn-icon" onclick="activarUsuario(${u.id})" title="Activar"><i class="fas fa-check-circle" style="color:#2E7D32;"></i></button>`;
                const btnAnular = u.activo ? `<button class="btn-icon" onclick="anularUsuario(${u.id})" title="Anular"><i class="fas fa-ban" style="color:#C62828;"></i></button>` : '';

                html += `
                    <tr style="${!u.activo ? 'opacity:0.6;' : ''}">
                        <td style="font-weight:700;">${u.nombre} ${u.apellido || ''}</td>
                        <td class="text-muted">${u.usuario || '—'}</td>
                        <td class="text-muted">${u.correo || '—'}</td>
                        <td><span class="rol-badge ${rolClass}">${u.rol || '—'}</span></td>
                        <td style="text-align:center;">${estatus}</td>
                        <td style="text-align:right; white-space:nowrap;">
                            <button class="btn-icon" onclick="editarUsuario(${u.id})" title="Editar"><i class="fas fa-edit"></i></button>
                            <button class="btn-icon" onclick="abrirPassword(${u.id}, '${escapeHtml(u.nombre + ' ' + (u.apellido || ''))}')" title="Restablecer contraseña"><i class="fas fa-key"></i></button>
                            ${btnAnular}
                            ${btnActivar}
                        </td>
                    </tr>
                `;
            });
            $('#tbUsuarios').html(html);
        }

        function escapeHtml(text) {
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function validarEmail(correo) {
            const partes = correo.split('@@');
            if (partes.length !== 2) return false;
            const usuario = partes[0];
            const dominio = partes[1];
            if (!usuario || !dominio) return false;
            if (usuario.indexOf(' ') >= 0 || dominio.indexOf(' ') >= 0) return false;
            const dominioPartes = dominio.split('.');
            return dominioPartes.length >= 2 && dominioPartes.every(function(p) { return p.length > 0; });
        }

        function abrirModal() {
            $('#modalTitulo').text('Nuevo Usuario');
            $('#uId').val(0);
            $('#uNombre').val('');
            $('#uApellidos').val('');
            $('#uCorreo').val('');
            $('#uUsuario').val('');
            $('#uPassword').val('');
            $('#uRol').val('');
            $('#colPassword').show();
            $('#modalUsuarioOverlay').addClass('show');
        }

        function editarUsuario(id) {
            const u = usuarios.find(x => x.id === id);
            if (!u) return;

            $('#modalTitulo').text('Editar Usuario');
            $('#uId').val(u.id);
            $('#uNombre').val(u.nombre);
            $('#uApellidos').val(u.apellido);
            $('#uCorreo').val(u.correo);
            $('#uUsuario').val(u.usuario);
            $('#uPassword').val('');
            $('#uRol').val(u.rolId || '');
            $('#colPassword').hide();
            $('#modalUsuarioOverlay').addClass('show');
        }

        function cerrarModalUsuario(e) {
            if (e && e.target !== document.getElementById('modalUsuarioOverlay') && e.target.closest('.modal-usuario-box')) return;
            $('#modalUsuarioOverlay').removeClass('show');
        }

        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && $('#modalUsuarioOverlay').hasClass('show')) {
                cerrarModalUsuario();
            }
        });

        function guardarUsuario() {
            const id = parseInt($('#uId').val() || 0);
            const req = {
                id: id,
                nombre: $('#uNombre').val().trim(),
                apellidos: $('#uApellidos').val().trim(),
                correo: $('#uCorreo').val().trim(),
                usuario: $('#uUsuario').val().trim(),
                password: $('#uPassword').val(),
                rolId: parseInt($('#uRol').val() || 0)
            };

            if (!req.nombre || !req.usuario) {
                Swal.fire('Atención', 'Nombre y usuario son obligatorios.', 'warning');
                return;
            }
            if (!req.correo) {
                Swal.fire('Atención', 'El correo electrónico es obligatorio.', 'warning');
                return;
            }
            if (!validarEmail(req.correo)) {
                Swal.fire('Atención', 'El correo electrónico no tiene un formato válido.', 'warning');
                return;
            }
            if (!req.rolId) {
                Swal.fire('Atención', 'Debes seleccionar un rol.', 'warning');
                return;
            }
            if (id === 0 && !req.password) {
                Swal.fire('Atención', 'La contraseña es obligatoria para nuevos usuarios.', 'warning');
                return;
            }

            fetch('@Url.Action("Guardar", "Usuarios")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(req)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    $('#modalUsuarioOverlay').removeClass('show');
                    Swal.fire('Guardado', res.message, 'success').then(() => cargarUsuarios());
                } else {
                    Swal.fire('Error', res.error, 'error');
                }
            })
            .catch(e => {
                console.error(e);
                Swal.fire('Error', 'No se pudo guardar el usuario.', 'error');
            });
        }

        function abrirPassword(id, nombre) {
            usuarioActualId = id;
            $('#pId').val(id);
            $('#pNombre').text(nombre);
            $('#pPassword').val('');
            $('#modalPassword').modal('show');
        }

        function guardarPassword() {
            const password = $('#pPassword').val();
            if (!password) {
                Swal.fire('Atención', 'Escribe una contraseña.', 'warning');
                return;
            }

            fetch('@Url.Action("CambiarPassword", "Usuarios")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ id: usuarioActualId, password: password })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    $('#modalPassword').modal('hide');
                    Swal.fire('Actualizado', res.message, 'success');
                } else {
                    Swal.fire('Error', res.error, 'error');
                }
            })
            .catch(e => {
                console.error(e);
                Swal.fire('Error', 'No se pudo cambiar la contraseña.', 'error');
            });
        }

        function anularUsuario(id) {
            Swal.fire({
                title: '¿Anular usuario?',
                text: 'El usuario no podrá iniciar sesión, pero sus registros históricos se conservarán.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Anular',
                confirmButtonColor: '#C62828',
                cancelButtonText: 'Cancelar'
            }).then(result => {
                if (!result.isConfirmed) return;
                cambiarEstatus(id, 'Anular');
            });
        }

        function activarUsuario(id) {
            cambiarEstatus(id, 'Activar');
        }

        function cambiarEstatus(id, accion) {
            var url = accion === 'Activar'
                ? '@Url.Action("Activar", "Usuarios")'
                : '@Url.Action("Anular", "Usuarios")';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ id: id })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    Swal.fire('Listo', res.message, 'success').then(() => cargarUsuarios());
                } else {
                    Swal.fire('Error', res.error, 'error');
                }
            })
            .catch(e => {
                console.error(e);
                Swal.fire('Error', 'No se pudo cambiar el estatus.', 'error');
            });
        }

    </script>
}
